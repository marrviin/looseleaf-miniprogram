{
  "name": "looseleaf-miniprogram",
  "version": "0.0.0",
  "private": true,
  "description": "Looseleaf hand-drawn UI, ported to WeChat Mini Program. Component library + example app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "gen": "node script/gen-component.mjs",
    "build": "node script/build.mjs",
    "bake:tokens": "node script/bake-tokens.mjs",
    "bake:paper-tiles": "node script/bake-paper-tiles.mjs",
    "build:ink": "node script/bundle-ink.mjs",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "culori": "^4.0.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
