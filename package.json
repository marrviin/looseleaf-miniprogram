{
  "name": "looseleaf-miniprogram",
  "version": "0.0.0",
  "private": true,
  "description": "Looseleaf hand-drawn UI, ported to WeChat Mini Program. Component library + example app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "gen": "node script/gen-component.mjs",
    "build": "node script/build.mjs",
    "bake:tokens": "node script/bake-tokens.mjs",
    "bake:paper-tiles": "node script/bake-paper-tiles.mjs",
    "build:ink": "node script/bundle-ink.mjs",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "test:gates": "node script/check-gates.mjs",
    "test:automator": "npm run build && node script/automator-smoke.mjs",
    "test:visual": "node script/visual-diff.mjs"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "culori": "^4.0.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "miniprogram-automator": "^0.13.0",
    "miniprogram-simulate": "^1.6.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0"
}
