/* ll-carousel-item — full-width slide, the gap rides on the right */
.ll-carousel-item {
  flex-shrink: 0;
  flex-grow: 0;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding-right: 16px;
}
.ll-carousel-item.is-vertical {
  height: 100%;
  padding-right: 0;
  padding-bottom: 16px;
}
