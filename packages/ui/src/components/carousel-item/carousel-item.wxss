/* ll-carousel-item — full-width slide; the gap rides on the LEFT padding
   (upstream ps-4) so every snap puts the slide's content edge flush at the
   viewport's left; the track's negative start margin (-ms-4) pulls the
   first slide's content back to 0 */
.ll-carousel-item {
  flex-shrink: 0;
  flex-grow: 0;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding-left: 16px;
}
.ll-carousel-item.is-vertical {
  height: 100%;
  padding-left: 0;
  padding-top: 16px;
}
