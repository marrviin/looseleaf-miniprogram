/* ll-item-title — text-base leading-snug font-bold, w-fit with gap-2 */
/* @ll-import tokens */
.ll-item-title {
  display: flex;
  width: fit-content;
  align-items: center;
  gap: 16rpx; /* gap-2 */
  font-family: 'Kevin Sans', sans-serif;
  font-size: 28rpx; /* text-base × 0.88 */
  font-weight: 700;
  line-height: 1.375; /* leading-snug */
}
