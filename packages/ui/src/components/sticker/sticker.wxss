/* ll-sticker — upstream: pointer-events-none shrink-0 overflow-visible svg,
   ll-drop-sticker when shadow, ll-tilt-layer when rotate="auto". */
.ll-sticker {
  position: relative;
  display: inline-block;
  flex-shrink: 0;
  pointer-events: none;
  overflow: visible;
}

/* --ll-drop-sticker with the shade token precomputed */
.ll-sticker--shadow {
  filter: drop-shadow(0 1px 0.6px rgba(58, 44, 30, 0.26))
    drop-shadow(0 3px 3px rgba(58, 44, 30, 0.14));
}

.ll-sticker__art {
  position: absolute;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
