.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
/* flex flex-wrap items-center gap-6 */
.sticker-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 42rpx; /* gap-6 */
  padding: 32rpx 16rpx;
}
.sticker-row--loose {
  gap: 56rpx; /* gap-8 */
}
.sticker-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.sticker-caption {
  font-size: 20rpx;
  color: #8a857c;
}
.row {
  display: flex;
  justify-content: center;
  padding: 32rpx 16rpx;
}
.card-wrap {
  position: relative;
}
.card-copy {
  max-width: 451rpx; /* max-w-[16rem] */
}
.track-wrap {
  position: relative;
}
.track-label {
  padding-left: 84rpx; /* ps-12 */
}
/* gallery — grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] gap-4 pt-2;
   li flex flex-col items-center gap-1 */
.shelf {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(253rpx, 1fr));
  gap: 28rpx; /* gap-4 */
  padding-top: 14rpx; /* pt-2 */
  width: 100%;
  box-sizing: border-box;
}
.shelf-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx; /* gap-1 */
}
.shelf-name {
  font-size: 23rpx; /* text-sm */
  color: var(--ll-pencil-text, #8e887f); /* text-pencil-text */
}
