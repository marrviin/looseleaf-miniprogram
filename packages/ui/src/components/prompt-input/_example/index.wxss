.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack-12 {
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* gap-3 */
  padding: 16rpx 0;
}
.said-line {
  font-size: 25rpx;
  color: #4a433c;
}
/* 01 — the sent list under the composer */
.sent {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sent__item {
  font-size: 25rpx;
  color: #2a2420;
  white-space: pre-wrap;
}
/* 02 — the typing indicator keeps its row while paused */
.stream-row {
  min-height: 64rpx;
}
/* 04 — real Attachment chips (size="sm") in the attachments row */
.chips {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 24rpx;
}
