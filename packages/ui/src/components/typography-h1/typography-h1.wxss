/* ll-typography-h1 — script heading + pencil rule */
/* @ll-import tokens */
.ll-typography-h1 {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-weight: 700;
  font-size: 48px;
  line-height: 1.02;
  letter-spacing: -0.01em;
  color: var(--ll-ink, #2a2420);
}
.ll-typography-h1::after {
  content: '';
  display: block;
  height: 2px;
  margin-top: 8px;
  border-radius: 999px;
  background: currentColor;
  opacity: 0.55;
}
.ll-typography-h1.no-rule::after {
  display: none;
}
