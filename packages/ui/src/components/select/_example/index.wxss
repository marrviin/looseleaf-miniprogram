.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
/* layout: center — the example sits in a stage row */
.center-stage {
  padding: 32rpx 0;
}
/* label over field (upstream grid gap-2) */
.grid-sm {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* gap-2 */
}
/* sizes/states: grid-cols-2 gap-x-8 gap-y-5 items-start */
.grid2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 64rpx; /* gap-x-8 */
  row-gap: 40rpx; /* gap-y-5 */
  align-items: start;
  max-width: 960rpx;
}
@media (max-width: 600px) {
  .grid2x2 {
    grid-template-columns: 1fr; /* max-sm:grid-cols-1 */
  }
}
.err-note {
  font-size: 25rpx; /* text-sm x .88 */
  color: #c2412d; /* text-red */
}
/* form: grid gap-4 max-w-sm */
.form {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* gap-4 */
  max-width: 768rpx; /* max-w-sm */
}
.form-foot {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.sent-note {
  font-size: 25rpx;
  color: #4a433c; /* text-ink-muted */
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 16rpx 0;
}
