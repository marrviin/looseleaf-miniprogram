.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
/* layout: center — the example sits in a stage row */
.center-stage {
  padding: 32rpx 0;
}
/* label over field (upstream grid gap-2) */
.grid-sm {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* gap-2 */
}
/* sizes/states: grid-cols-2 gap-x-8 gap-y-5 items-start */
.grid2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 64rpx; /* gap-x-8 */
  row-gap: 40rpx; /* gap-y-5 */
  align-items: start;
  max-width: 960rpx;
}
@media (max-width: 600px) {
  .grid2x2 {
    grid-template-columns: 1fr; /* max-sm:grid-cols-1 */
  }
}
.err-note {
  font-size: 25rpx; /* text-sm x .88 */
  color: #c2412d; /* text-red */
}
/* form: grid gap-4 max-w-sm */
.form {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* gap-4 */
  max-width: 768rpx; /* max-w-sm */
}
.form-foot {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.sent-note {
  font-size: 25rpx;
  color: #4a433c; /* text-ink-muted */
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 16rpx 0;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
