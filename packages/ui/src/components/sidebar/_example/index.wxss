/* ll-sidebar demo — boilerplate + the docs-page demo frames. */

.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title { font-weight: bold; font-size: 40rpx; margin-bottom: 8rpx; }
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-desc { font-size: 24rpx; color: #8a857c; line-height: 1.6; margin-bottom: 20rpx; }

/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}

/* demo frames — upstream layout:"full" fixed heights, contained (see the
   wxml header note about `static`). */
.frame {
  position: relative;
  overflow: hidden;
  border-radius: 4rpx;
  /* headroom so the binder clip standing on the pad's top edge shows in
     full instead of being cut in half by the frame */
  padding-top: 56rpx;
  box-sizing: border-box;
}
.f-230 { height: 460rpx; }
.f-250 { height: 500rpx; }
.f-260 { height: 520rpx; }
.f-320 { height: 640rpx; }
.f-360 { height: 720rpx; }
.f-380 { height: 760rpx; }
.f-400 { height: 800rpx; }
.f-420 { height: 840rpx; }
.f-460 { height: 920rpx; }
.f-560 { height: 1120rpx; }
.f-600 { height: 1200rpx; }

/* row labels truncate like upstream's [&>span:last-child]:truncate */
.ell {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bold { font-weight: 700; }
.dim { color: #8a857c; font-size: 22rpx; }

/* lg button's two-line brand/account block */
.two-line {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  text-align: left;
  line-height: 1.25;
}
.brand-chip {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(248, 220, 76, 0.8); /* bg-marker/80 */
  color: #2a2420;
}

/* inset page content */
.inset-header {
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}
.inset-pad {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.inset-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.inset-row.wrap {
  flex-wrap: wrap;
}
.script-h2 {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 600;
}
.inset-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a857c;
}

/* 53 — the group label as a collapsible trigger */
.group-label-trigger {
  display: flex;
  height: 64rpx;
  align-items: center;
  padding: 0 16rpx;
  font-family: 'IBM Plex Mono', Menlo, monospace;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  color: #4a433c;
}

.empty-row {
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #8a857c;
}
