<!-- ll-sidebar demo — mirrors the upstream docs page (#/components/sidebar).
     Every example pad renders docked inside its frame (the `static` escape
     hatch — see index.js header note); on a real phone the same markup
     without `static` gives the Sheet. -->
<view class="demo">
  <ll-page-title underline="highlight" seed="sidebar" custom-style="margin-bottom:16rpx;">Sidebar</ll-page-title>
  <view class="sec-desc">An order pad hung from the top of the screen: cream paper with a torn top edge and a binder clip. Rows carry their own line of the pad's ruling, hover is the highlighter, and the current page is marked with a highlighter swipe and a bracket in the margin. It collapses to icons or slides away, becomes a sheet on phones, and stays cheap for a long menu: only the one active row draws anything.</view>

  <!-- ============ Preview / Demo (50) ============ -->
  <view class="sec sec--desk">
    <view class="sec-h2">Preview</view>
    <view class="sub-h3">Demo</view>
    <view class="sec-desc">Official `sidebar-demo`: one group of five links and an inset with the trigger. The pad hangs from a binder clip and every link wears the highlighter when pointed at. (Ctrl/Cmd+B has no keyboard here — tap the trigger.)</view>
    <view class="frame f-320">
      <ll-sidebar-provider custom-style="min-height:0;height:100%;">
        <ll-sidebar static seed="official-demo">
          <ll-sidebar-content>
            <ll-sidebar-group>
              <ll-sidebar-group-label>Application</ll-sidebar-group-label>
              <ll-sidebar-group-content>
                <ll-sidebar-menu>
                  <ll-sidebar-menu-item wx:for="{{['house','inbox','calendar','search','settings']}}" wx:key="*this">
                    <ll-sidebar-menu-button>
                      <ll-icon name="{{item}}" size="{{16}}" />
                      <text class="ell">{{item === 'house' ? 'Home' : item === 'inbox' ? 'Inbox' : item === 'calendar' ? 'Calendar' : item === 'search' ? 'Search' : 'Settings'}}</text>
                    </ll-sidebar-menu-button>
                  </ll-sidebar-menu-item>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
          </ll-sidebar-content>
        </ll-sidebar>
        <ll-sidebar-inset>
          <view class="inset-header">
            <ll-sidebar-trigger />
          </view>
        </ll-sidebar-inset>
      </ll-sidebar-provider>
    </view>
  </view>

  <!-- ============ Examples ============ -->
  <view class="sec sec--desk">
    <view class="sec-h2">Examples</view>

