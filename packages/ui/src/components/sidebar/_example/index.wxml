                      <ll-icon name="{{item.icon}}" size="{{16}}" />
                      <text class="ell">{{item.name}}</text>
                    </ll-sidebar-menu-button>
                  </ll-sidebar-menu-item>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
          </ll-sidebar-content>
        </ll-sidebar>
      </ll-sidebar-provider>
    </view>

    <!-- 56 — menu action and badge -->
    <view class="sub-h3">Menu action and badge</view>
    <view class="sec-desc">Official `sidebar-menu-action` and `sidebar-menu-badge` in one pad. Top group: each row has a `SidebarMenuAction` (a small button that opens a menu). Bottom group: a `SidebarMenuBadge` writes a count in the margin in blue felt tip. Action and badge share the same corner, so a row takes one or the other.</view>
    <view class="frame f-380">
      <ll-sidebar-provider custom-style="min-height:0;height:100%;">
        <ll-sidebar static seed="official-menu-action">
          <ll-sidebar-content>
            <ll-sidebar-group>
              <ll-sidebar-group-label>Projects</ll-sidebar-group-label>
              <ll-sidebar-group-content>
                <ll-sidebar-menu>
                  <ll-sidebar-menu-item wx:for="{{actionRows}}" wx:key="name">
                    <ll-sidebar-menu-button>
                      <ll-icon name="{{item.icon}}" size="{{16}}" />
                      <text class="ell">{{item.name}}</text>
                    </ll-sidebar-menu-button>
                    <ll-dropdown-menu side="right" align="start" width="{{192}}" seed="ma-{{index}}" aria-label="More">
                      <ll-sidebar-menu-action slot="trigger" aria-label="More">
                        <ll-icon name="ellipsis" size="{{16}}" />
                      </ll-sidebar-menu-action>
                      <ll-dropdown-menu-item><text>Edit Project</text></ll-dropdown-menu-item>
                      <ll-dropdown-menu-item><text>Delete Project</text></ll-dropdown-menu-item>
                    </ll-dropdown-menu>
                  </ll-sidebar-menu-item>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
            <ll-sidebar-group>
              <ll-sidebar-group-label>Unread</ll-sidebar-group-label>
              <ll-sidebar-group-content>
                <ll-sidebar-menu>
                  <ll-sidebar-menu-item wx:for="{{badgeRows}}" wx:key="name">
                    <ll-sidebar-menu-button>
                      <ll-icon name="{{item.icon}}" size="{{16}}" />
                      <text class="ell">{{item.name}}</text>
                    </ll-sidebar-menu-button>
                    <ll-sidebar-menu-badge>{{item.badge}}</ll-sidebar-menu-badge>
                  </ll-sidebar-menu-item>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
          </ll-sidebar-content>
        </ll-sidebar>
      </ll-sidebar-provider>
    </view>

    <!-- 57 — menu sub -->
    <view class="sub-h3">Menu sub</view>
    <view class="sec-desc">Official `sidebar-menu-sub`: a table of contents, each section a button over an indented `SidebarMenuSub` that is always open. A pencil line runs down the start of each sub-list. The content scrolls inside the pad when it is taller than the pad.</view>
    <view class="frame f-420">
      <ll-sidebar-provider custom-style="min-height:0;height:100%;">
        <ll-sidebar static seed="official-menu-sub">
          <ll-sidebar-content>
            <ll-sidebar-group>
              <ll-sidebar-group-content>
                <ll-sidebar-menu>
                  <ll-sidebar-menu-item wx:for="{{toc}}" wx:key="slug" wx:for-item="group">
                    <ll-sidebar-menu-button><text class="ell">{{group.title}}</text></ll-sidebar-menu-button>
                    <ll-sidebar-menu-sub>
                      <ll-sidebar-menu-sub-item wx:for="{{group.items}}" wx:key="slug" wx:for-item="sub">
                        <ll-sidebar-menu-sub-button is-active="{{sub.title === tocActive}}">
                          <text class="ell">{{sub.title}}</text>
                        </ll-sidebar-menu-sub-button>
                      </ll-sidebar-menu-sub-item>
                    </ll-sidebar-menu-sub>
                  </ll-sidebar-menu-item>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
          </ll-sidebar-content>
        </ll-sidebar>
      </ll-sidebar-provider>
    </view>

    <!-- 58 — menu collapsible -->
    <view class="sub-h3">Menu collapsible</view>
    <view class="sec-desc">Official `sidebar-menu-collapsible`: the same table of contents with each section folding open and shut. The first section starts open, and the chevron turns from the collapsible's state.</view>
    <view class="frame f-420">
      <ll-sidebar-provider custom-style="min-height:0;height:100%;">
        <ll-sidebar static seed="official-menu-collapsible">
          <ll-sidebar-content>
            <ll-sidebar-group>
              <ll-sidebar-group-content>
                <ll-sidebar-menu>
                  <block wx:for="{{toc}}" wx:key="slug" wx:for-item="group" wx:for-index="gi">
                    <ll-collapsible default-open="{{gi === 0}}">
                      <ll-sidebar-menu-item>
                        <ll-collapsible-trigger>
                          <ll-sidebar-menu-button>
                            <text class="ell">{{group.title}}</text>
                            <ll-collapsible-indicator custom-style="margin-left:auto;" />
                          </ll-sidebar-menu-button>
                        </ll-collapsible-trigger>
                        <ll-collapsible-content>
                          <ll-sidebar-menu-sub>
                            <ll-sidebar-menu-sub-item wx:for="{{group.items}}" wx:key="slug" wx:for-item="sub">
                              <ll-sidebar-menu-sub-button is-active="{{sub.title === tocActive}}">
                                <text class="ell">{{sub.title}}</text>
                              </ll-sidebar-menu-sub-button>
                            </ll-sidebar-menu-sub-item>
                          </ll-sidebar-menu-sub>
                        </ll-collapsible-content>
                      </ll-sidebar-menu-item>
                    </ll-collapsible>
                  </block>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
          </ll-sidebar-content>
        </ll-sidebar>
      </ll-sidebar-provider>
    </view>

    <!-- 59 — controlled and loading -->
    <view class="sub-h3">Controlled and loading</view>
    <view class="sec-desc">Official `sidebar-controlled` and `sidebar-rsc` in one pad. Controlled: `open` and `onOpenChange` on the provider, with the state kept in the page so any button can open and close the pad. Loading: `SidebarMenuSkeleton` rows (with icons) stand in while the projects load, then are swapped for the list; Reload runs it again.</view>
    <view class="frame f-360">
      <ll-sidebar-provider id="provider-59" custom-style="min-height:0;height:100%;" open="{{ctrlOpen}}" bind:change="onCtrlChange">
        <ll-sidebar static seed="official-controlled">
          <ll-sidebar-content>
            <ll-sidebar-group>
              <ll-sidebar-group-label>Projects</ll-sidebar-group-label>
              <ll-sidebar-group-content>
                <ll-sidebar-menu>
                  <block wx:if="{{ctrlLoaded}}">
                    <ll-sidebar-menu-item wx:for="{{ctrlProjects}}" wx:key="*this">
                      <ll-sidebar-menu-button>
                        <ll-icon name="{{ctrlIcons[index]}}" size="{{16}}" />
                        <text class="ell">{{item}}</text>
                      </ll-sidebar-menu-button>
                    </ll-sidebar-menu-item>
                  </block>
                  <block wx:else>
                    <ll-sidebar-menu-item wx:for="{{ctrlProjects}}" wx:key="*this">
                      <ll-sidebar-menu-skeleton show-icon seed="{{item}}" />
                    </ll-sidebar-menu-item>
                  </block>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
          </ll-sidebar-content>
        </ll-sidebar>
        <ll-sidebar-inset>
          <view class="inset-pad">
            <view class="inset-row">
              <ll-button size="sm" variant="ghost" bind:tap="onCtrlToggle">
                <ll-icon name="{{ctrlOpen ? 'panel-left-close' : 'panel-left-open'}}" size="{{16}}" />
                {{ctrlOpen ? 'Close' : 'Open'}} Sidebar
              </ll-button>
              <ll-button size="sm" variant="outline" disabled="{{!ctrlLoaded}}" bind:tap="onCtrlReload">
                <ll-icon name="rotate-cw" size="{{16}}" /> Reload
              </ll-button>
            </view>
          </view>
        </ll-sidebar-inset>
      </ll-sidebar-provider>
    </view>
  </view>
</view>

<!-- 54's toaster (upstream parks it bottom-right inside the frame) -->
<ll-toaster id="t-group-action" toaster-id="sidebar-group-action" />
