    <!-- 04 — search and loading -->
    <view class="sub-h3">Search and loading</view>
    <view class="sec-desc">A long menu stays cheap: 40 notebooks are 40 list items with no drawing each, only the current one draws its mark. The search field filters them, the plus on the label adds one, and Reload shows loading rows (their widths come from a seed, so they are the same every time).</view>
    <view class="frame f-560">
      <ll-sidebar-provider custom-style="min-height:0;height:100%;">
        <ll-sidebar static seed="search">
          <ll-sidebar-header>
            <ll-sidebar-input aria-label="Search notebooks" placeholder="Search notebooks…" value="{{q}}" bind:input="onSearchInput" />
