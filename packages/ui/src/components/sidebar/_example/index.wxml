              </ll-sidebar-group-action>
              <ll-sidebar-group-content>
                <ll-sidebar-menu>
                  <block wx:if="{{searchLoading}}">
                    <ll-sidebar-menu-item wx:for="{{[0, 1, 2, 3, 4, 5, 6]}}" wx:key="*this">
                      <ll-sidebar-menu-skeleton show-icon seed="sk-{{index}}" />
                    </ll-sidebar-menu-item>
                  </block>
                  <block wx:else>
                    <ll-sidebar-menu-item wx:for="{{searchNames}}" wx:key="*this">
                      <ll-sidebar-menu-button is-active="{{searchCurrent === item}}" data-name="{{item}}" bind:tap="onPickNotebook">
                        <ll-icon name="file-text" size="{{16}}" />
                        <text class="ell">{{item}}</text>
                      </ll-sidebar-menu-button>
                    </ll-sidebar-menu-item>
                    <view wx:if="{{searchNames.length === 0}}" class="empty-row">No notebook matches “{{q}}”.</view>
                  </block>
                </ll-sidebar-menu>
              </ll-sidebar-group-content>
            </ll-sidebar-group>
          </ll-sidebar-content>
        </ll-sidebar>
        <ll-sidebar-inset>
          <view class="inset-pad">
            <text class="script-h2">{{searchCurrent}}</text>
            <view class="inset-note">{{searchLoading ? 'Loading notebooks…' : searchNames.length + ' notebooks shown.'}}</view>
            <ll-button variant="outline" size="sm" custom-style="margin-top:16rpx;" disabled="{{searchLoading}}" bind:tap="onSearchReload">
              <ll-icon name="rotate-cw" size="{{16}}" /> Reload
            </ll-button>
          </view>
        </ll-sidebar-inset>
      </ll-sidebar-provider>
