/* ll-arrow demo */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title { font-weight: bold; font-size: 40rpx; margin-bottom: 8rpx; }
.sec { margin-top: 40rpx; }
.sub-h3 { font-size: 30rpx; font-weight: 700; color: #2a2420; margin: 20rpx 0 12rpx; }
.sec-desc { font-size: 24rpx; color: #8a857c; line-height: 1.6; margin-bottom: 16rpx; }
.aw-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 20rpx;
}
.aw-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 24rpx;
  margin-top: 24rpx;
}
.aw-fig { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.aw-cap { font-size: 20rpx; color: #5a554e; }
.aw-cap.is-left { text-align: left; }
.aw-point {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
  min-height: 200rpx;
}
.aw-aim { display: flex; align-items: center; gap: 8rpx; }
.aw-target { display: inline-block; }
.aw-script {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 24px;
  color: #2c4f9e;
}
.aw-script.is-title { color: #2a2420; }
.aw-label-wrap {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding-bottom: 32rpx;
}
.aw-card-head { padding: 4px 0 12px; }
.aw-line {
  height: 40px;
  border-bottom: 1px dashed #6a6e78;
}
