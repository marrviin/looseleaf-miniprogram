/* ll-arrow demo */
.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title { font-weight: bold; font-size: 40rpx; margin-bottom: 8rpx; }
.sec { margin-top: 40rpx; padding: 32rpx; }
.sub-h3 { font-size: 30rpx; font-weight: 700; color: #2a2420; margin: 20rpx 0 12rpx; }
.sec-desc { font-size: 24rpx; color: #8a857c; line-height: 1.6; margin-bottom: 16rpx; }
.aw-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 20rpx;
}
.aw-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 24rpx;
  margin-top: 24rpx;
}
.aw-fig { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.aw-cap { font-size: 20rpx; color: #5a554e; }
.aw-cap.is-left { text-align: left; }
.aw-point {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
  min-height: 200rpx;
}
.aw-aim { display: flex; align-items: center; gap: 8rpx; }
.aw-target { display: inline-block; }
.aw-script {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 24px;
  color: #2c4f9e;
}
.aw-script.is-title { color: #2a2420; }
.aw-label-wrap {
  position: relative;
  /* upstream: w-full max-w-sm pe-32, arrow absolute end-20 bottom-8 -
     reserve the end lane so the labelled arrow stays inside the stage */
  padding-right: 128px;
  padding-bottom: 32rpx;
}
/* the arrow itself: absolute in the reserved lane (it can't take position
   styling via custom-style on a virtualHost) */
.aw-arrow {
  position: absolute;
  right: 80px; /* end-20 */
  bottom: 16px; /* bottom-8 against the wrap's padding-bottom */
}
.aw-card-head { padding: 4px 0 12px; }
.aw-line {
  height: 40px;
  border-bottom: 1px dashed #6a6e78;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
