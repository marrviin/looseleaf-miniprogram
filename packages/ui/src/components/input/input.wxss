/* @ll-import tokens */
.ll-input {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  width: 100%; /* w-full */
  height: 72rpx; /* h-9 */
  min-width: 0;
  box-sizing: border-box;
  font-size: 32rpx; /* text-base */
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
.ll-input__control {
  flex: 1;
  width: 100%;
  height: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: 8rpx 24rpx; /* py-1 px-3 */
  padding-left: var(--ll-input-pl, 24rpx);
  font-size: inherit;
  color: var(--ll-input-ink, #2c4f9e); /* what you type is blue felt */
  caret-color: var(--ll-caret, #2c4f9e);
  background: transparent;
}
.ll-input__placeholder {
  color: var(--ll-placeholder, #5a554e); /* graphite */
}
.ll-input__control--disabled {
  color: #5a554e; /* disabled:text-pencil-text */
}
