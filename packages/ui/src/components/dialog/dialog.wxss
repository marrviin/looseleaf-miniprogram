/* ll-dialog — upstream DialogOverlay/Frame/Content. The dim is a lamp-lit
   umber radial (--ll-overlay-dim, tokens precomputed); the sheet is a
   ll-paper. z follows upstream: overlay 1000. */
/* @ll-import tokens */
.ll-dialog {
  position: fixed;
  inset: 0;
  z-index: 1000; /* --ll-z-overlay */
}

.ll-dialog__overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse 90% 80% at 50% 38%,
    rgba(58, 44, 30, 0.16),
    rgba(58, 44, 30, 0.23) 55%,
    rgba(58, 44, 30, 0.34)
  );
  animation: ll-dialog-fade-in 0.15s ease-out both;
}

.ll-dialog__frame {
  position: absolute;
  inset: 0;
  display: flex;
  padding: 32rpx; /* p-4 */
  box-sizing: border-box;
  pointer-events: none;
}

.ll-dialog__sheet {
  pointer-events: auto;
  margin: auto; /* m-auto */
  width: 100%;
  max-width: 512px; /* max-w-lg */
  animation: ll-dialog-sheet-drop 0.3s var(--ll-ease-dialog, cubic-bezier(0.3, 0.75, 0.4, 1)) both;
}

/* phones (upstream max-sm): bottom sheet — full width, flat, bottom-anchored */
@media (max-width: 639.9px) {
  .ll-dialog__frame {
    padding: 0;
  }
  .ll-dialog__sheet {
    max-width: none;
    margin-bottom: 0;
    animation-name: ll-dialog-slide-up;
    animation-duration: 0.15s;
  }
}

/* exits: fade (zoom from sm, slide to bottom on phones) */
.ll-dialog--closing .ll-dialog__overlay {
  animation: ll-dialog-fade-out 0.15s ease-in both;
}
.ll-dialog--closing .ll-dialog__sheet {
  animation: ll-dialog-fade-zoom-out 0.15s ease-in both;
}
@media (max-width: 639.9px) {
  .ll-dialog--closing .ll-dialog__sheet {
    animation-name: ll-dialog-slide-down;
  }
}

/* the doodled x — size-8 grid place-items-center, end-3 top-3, z raised */
.ll-dialog__x {
  position: absolute;
  top: 24rpx; /* top-3 */
  right: 24rpx; /* end-3 */
  z-index: 8; /* --ll-z-raised */
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ll-dialog__x .ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

@keyframes ll-dialog-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes ll-dialog-fade-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
@keyframes ll-dialog-sheet-drop {
  0% {
    opacity: 0;
    transform: translateY(-14px) rotate(-1.2deg) scale(1.02);
  }
  70% {
    opacity: 1;
    transform: translateY(1px) rotate(0.15deg) scale(0.998);
  }
  100% {
    transform: none;
  }
}
@keyframes ll-dialog-slide-up {
  from {
    opacity: 0;
    transform: translateY(64px); /* slide-in-from-bottom-16 */
  }
  to {
    transform: none;
  }
}
@keyframes ll-dialog-fade-zoom-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
    transform: scale(0.95); /* zoom-out-95 */
  }
}
@keyframes ll-dialog-slide-down {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
    transform: translateY(32px); /* slide-out-to-bottom-8 */
  }
}
