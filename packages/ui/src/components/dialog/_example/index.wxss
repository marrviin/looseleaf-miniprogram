.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx; /* gap-4 */
  margin-bottom: 24rpx;
}
.center-row.wrap {
  flex-wrap: wrap;
}
.center-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.invited {
  font-size: 25rpx;
  color: #8a857c;
  min-height: 48rpx;
  text-align: center;
}
/* 01: grid grid-cols-4 items-center gap-4 py-2 */
.form-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 16rpx 0; /* py-2 */
}
.form-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.form-label {
  width: 25%;
  text-align: right;
  font-size: 28rpx;
}
.form-field {
  flex: 1;
}
.invite-field {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.share-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
/* 03 clauses: space-y-3, numbered bold */
.clause {
  font-size: 26rpx;
  line-height: 1.55;
  margin-bottom: 24rpx; /* space-y-3 */
}
.clause:last-child {
  margin-bottom: 0;
}
.clause-n {
  font-weight: 700;
}
