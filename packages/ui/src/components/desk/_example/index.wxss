.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.dk-script {
  display: block;
  font-size: 24px;
  line-height: 1.1;
  font-weight: 700;
  color: #2a2420;
}
.dk-small {
  display: block;
  margin-top: 8px;
  font-size: 26rpx;
  color: #2a2420;
}
.dk-title {
  display: block;
  font-size: 30px;
  line-height: 1.1;
  font-weight: 700;
  color: #2a2420;
}
.dk-body {
  display: block;
  margin-top: 12px;
  font-size: 26rpx;
  line-height: 1.6;
  color: #2a2420;
}
.dk-lamps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.dk-morning {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  max-width: 750rpx;
  margin: 0 auto;
}
.dk-stickies {
  display: flex;
  gap: 20px;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}
