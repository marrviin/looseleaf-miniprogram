/* ll-alert-description */
/* @ll-import tokens */
.ll-alert-description.is-destructive {
  color: var(--ll-red, #c2412d);
}
.ll-alert-description {
  grid-column: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  font-size: 14px;
  color: var(--muted-foreground, #4a433c);
  line-height: 1.625;
}
.ll-alert.is-destructive .ll-alert-description.is-destructive {
  color: var(--ll-red, #c2412d);
}
