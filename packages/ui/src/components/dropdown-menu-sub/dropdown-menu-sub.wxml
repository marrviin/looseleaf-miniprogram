<!-- ll-dropdown-menu-sub — MENU_SUB_TRIGGER: the row with a hand-drawn
     chevron that keeps the highlighter while open; the sub-slip sits
     beside it (alignOffset -4). -->
<view class="ll-menu-sub" style="{{customStyle}}">
  <view
    class="ll-menu-row ll-menu-sub__trigger {{open ? 'll-menu-row--hi' : ''}} {{disabled ? 'll-menu-row--disabled' : ''}}"
    hover-class="{{disabled || open ? '' : 'll-menu-row--hi'}}"
    hover-start-time="0"
    hover-stay-time="80"
    catchtap="onTriggerTap"
    aria-role="menuitem"
    aria-haspopup="menu"
    aria-expanded="{{open}}"
  >
    <ll-icon wx:if="{{icon}}" name="{{icon}}" size="{{16}}" />
    <text class="ll-menu-sub__label">{{label}}</text>
    <slot name="trigger" />
    <ll-icon name="chevron-right" size="{{16}}" custom-style="margin-left:auto;" />
  </view>

  <view
    wx:if="{{open}}"
    class="ll-menu-sub__panel {{placing ? 'is-placing' : ''}}"
    style="{{panelStyle}}"
    catch:tap="noop"
  >
    <ll-paper
      stock="{{stock}}"
      edge="{{edge}}"
      tilt="{{tilt}}"
      tape="{{tape}}"
      rules="none"
      seed="{{seed}}"
      shadow-css="{{liftShadow}}"
      custom-style="position:relative;display:block;width:100%;box-sizing:border-box;"
    >
      <view class="ll-menu-sub__viewport" style="{{viewportStyle}}">
        <slot />
      </view>
    </ll-paper>
  </view>
</view>
