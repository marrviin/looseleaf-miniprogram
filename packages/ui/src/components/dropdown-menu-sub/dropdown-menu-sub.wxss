/* ll-dropdown-menu-sub — MENU_SUB_TRIGGER (ROW + chevron) and the
   sub-slip's viewport (p-1, scrolls like the main one). */
/* @ll-import tokens */
/* @ll-import menu-row */

.ll-menu-sub {
  position: relative;
  display: block;
}

.ll-menu-sub__label {
  min-width: 0;
}

/* the sub-slip, set down beside its row. position:absolute against the
   sub's own root — position:fixed is unreliable inside the menu subtree
   (renders relative to the scroll content, off-screen), and absolute keeps
   the math deterministic. The parent menu's viewport keeps overflow
   visible while its rows fit, so the flyout isn't clipped. */
.ll-menu-sub__panel {
  position: absolute;
  z-index: 20; /* above the paper visual and tape/fastener props */
  max-width: calc(100vw - 16rpx);
  opacity: 1;
  animation: ll-menu-sub-in 180ms cubic-bezier(0.2, 0.9, 0.3, 1.15) both;
}
.ll-menu-sub__panel.is-placing {
  opacity: 0;
  animation: none;
}

@keyframes ll-menu-sub-in {
  0% {
    opacity: 0;
    transform: scale(0.95) translateX(-8px);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}

.ll-menu-sub__viewport {
  display: block;
  padding: 8rpx; /* p-1 */
  box-sizing: border-box;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
