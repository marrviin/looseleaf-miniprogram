/* ll-corkboard-pin — a 24×24 push pin (the recipe draws at that size). */
/* @ll-import tokens */
.ll-corkboard-pin {
  position: relative;
  width: 100%;
  height: 100%;
}
.ll-ink-layer {
  position: absolute;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
