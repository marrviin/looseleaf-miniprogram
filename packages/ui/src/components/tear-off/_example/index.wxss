.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.said-line {
  font-size: 25rpx;
  color: #4a433c;
  margin-top: 12rpx;
}

/* ticket halves' content (upstream p-4 + type) */
.ticket-body {
  padding: 28rpx 32rpx;
}
.ticket-body--book {
  position: relative;
}
.script-h {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 52rpx;
  line-height: 1.1;
  color: #2a2420;
}
.script-h--stub {
  font-size: 52rpx;
  line-height: 56rpx;
}
.ticket-line {
  font-size: 25rpx;
  margin-top: 12rpx;
  color: #2a2420;
}
.ticket-dim {
  font-size: 24rpx;
  color: #8a857c;
}

/* the stub's copy */
.stub-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 0;
  text-align: center;
  width: 100%;
  height: 100%;
}
.stub-body--h {
  padding: 26rpx 24rpx 16rpx;
}
.stub-body--v {
  padding: 20rpx 24rpx;
  align-items: center;
}
.stub-sub {
  line-height: 52rpx;
}

/* 03 — the redeemed row under the book */
.book-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
  justify-content: center;
}
