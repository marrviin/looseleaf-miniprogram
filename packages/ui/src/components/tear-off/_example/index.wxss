.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.said-line {
  font-size: 25rpx;
  color: #4a433c;
  margin-top: 12rpx;
}

/* ticket halves' content (upstream p-4 + type) */
.ticket-body {
  padding: 28rpx 32rpx;
}
.ticket-body--book {
  position: relative;
}
.script-h {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 52rpx;
  line-height: 1.1;
  color: #2a2420;
}
.script-h--stub {
  font-size: 52rpx;
  line-height: 56rpx;
}
.ticket-line {
  font-size: 25rpx;
  margin-top: 12rpx;
  color: #2a2420;
}
.ticket-dim {
  font-size: 24rpx;
  color: #8a857c;
}

/* the stub's copy */
.stub-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 0;
  text-align: center;
  width: 100%;
  height: 100%;
}
.stub-body--h {
  padding: 26rpx 24rpx 16rpx;
}
.stub-body--v {
  padding: 20rpx 24rpx;
  align-items: center;
}
.stub-sub {
  line-height: 52rpx;
}

/* 03 — the redeemed row under the book */
.book-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
  justify-content: center;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
