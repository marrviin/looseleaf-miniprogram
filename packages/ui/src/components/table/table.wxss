/* ll-table — upstream tableSheet(): a display:table root (real column
   alignment, like upstream's <table>) in the bleed scroll container.
   Colors: --ll-rule/pencil-mark rows, --ll-ink-soft header double rule,
   --ll-hi-select highlighter. The fade masks live here as inherited vars
   (the comma lists must live in a stylesheet, like ll-item's). */
/* @ll-import tokens */
.ll-table-container {
  position: relative;
  /* bleed via negative margins + flex stretch (align-self default): the
     margin box fills the parent + 24px. calc(100%+24px) mis-resolves in a
     WeChat flex cross axis and made the scroller wider than the stage. */
  margin: -12px;
  max-width: none;
  padding: 12px;
  /* bleed scroll container: wide tables pan inside the stage instead of
     painting past its edge (upstream scrolls on narrow viewports).
     scroll-view clips natively; don't set overflow here (it interferes). */
  min-width: 0;
}

/* hide the native scroll bars (enhanced=false; show-scrollbar needs it) */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
  display: none;
}

.ll-table {
  display: table;
  /* drive the scroll: a width:100% display:table overflows the scroll-view's
     inner wrapper invisibly (min-content > wrapper) and paints unclipped;
     width:max-content makes the wrapper's scrollWidth real so scroll-x pans */
  width: max-content;
  min-width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  caption-side: bottom;
  isolation: isolate;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 26rpx; /* text-[15px] × 0.88 */
  line-height: 1.5;
  color: #2a2420;
  /* --ll-fade-s / -e / -se: rule fade-outs at the table edges */
  --ll-fade-s: linear-gradient(90deg, rgba(0, 0, 0, 0), #000 14px);
  --ll-fade-e: linear-gradient(90deg, #000 calc(100% - 26px), rgba(0, 0, 0, 0));
  --ll-fade-se: linear-gradient(90deg, rgba(0, 0, 0, 0), #000 14px, #000 calc(100% - 26px), rgba(0, 0, 0, 0));
}
