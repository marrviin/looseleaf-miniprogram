.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.said-line {
  font-size: 25rpx;
  color: #4a433c;
  margin-top: 12rpx;
}

/* 01 — invoice on a slip */
.invoice-h {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 52rpx;
  color: #2a2420;
}
.invoice-rows {
  margin-top: 20rpx;
}
.invoice-row {
  display: flex;
  gap: 28rpx;
  margin-top: 6rpx;
  font-size: 26rpx;
}
.invoice-k {
  width: 88rpx;
  color: #8a857c;
}
.invoice-v {
  flex: 1;
  color: #2a2420;
}
.invoice-num {
  font-variant-numeric: tabular-nums;
}

/* the tools row: above the paper's foot so the impressions have room */
.tool-row {
  margin-top: 180rpx;
  display: flex;
  align-items: flex-end;
  gap: 28rpx;
}
.tool-row--wrap {
  flex-wrap: wrap;
}

/* 02 — inks and shapes */
.inks-para {
  max-width: 560rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #2a2420;
}

/* 03 — the expense report */
.report-h {
  font-size: 32rpx;
  font-weight: 700;
  color: #2a2420;
}
.report-d {
  font-size: 24rpx;
  color: #8a857c;
  margin-top: 6rpx;
}
.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.report-amount {
  font-size: 44rpx;
  font-weight: 700;
  color: #2a2420;
  font-variant-numeric: tabular-nums;
}
.tool-row--report {
  margin-top: 120rpx;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
