.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  max-width: 768rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* upstream text-[17px] leading-[1.55] × 0.88 */
.para {
  font-size: 30rpx;
  line-height: 1.55;
  color: #2a2420;
}
/* upstream ll-num font-script text-4xl */
.price {
  font-family: var(--font-script, cursive);
  font-size: 68rpx;
  line-height: 1.2;
  color: #2a2420;
}
.price-new {
  color: var(--ll-red, #c2412d);
}
.price-note {
  font-size: 26rpx;
  color: var(--ll-ink-muted, #4a433c);
}
/* upstream: grid gap-3, row flex items-center gap-2.5 */
.todos {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  max-width: 640rpx;
}
.todo {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.todo-text {
  font-size: 30rpx;
  color: #2a2420;
}
.todo-done {
  color: var(--ll-ink-muted, #4a433c);
}
