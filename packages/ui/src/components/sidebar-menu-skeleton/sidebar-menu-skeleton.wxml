<!-- ll-sidebar-menu-skeleton — a loading row of pencil hatch. -->
<view class="ll-sidebar-menu-skeleton {{ll-class}}" style="{{customStyle}}">
  <ll-skeleton wx:if="{{showIcon}}" custom-style="width:32rpx;height:32rpx;flex-shrink:0;" />
  <ll-skeleton custom-style="height:32rpx;flex:1;max-width:{{width}};" />
</view>
