<!-- ll-popover — upstream popover.tsx: a Paper slip anchored to its trigger
     (Radix popper simplified: clamp to the viewport, flip when clipped),
     optional felt-tip arrow, pin/tape fasteners. Controlled via `open`;
     the trigger tap emits `change`. -->
<view class="ll-popover">
  <view class="ll-popover__trigger" catchtap="onTriggerTap">
    <slot name="trigger" />
  </view>

  <block wx:if="{{visible}}">
    <!-- transparent outside-catcher: tap anywhere else closes (Radix's
         dismiss-on-interact-outside); no dim, the page stays live -->
    <view class="ll-popover__catcher {{closing ? 'is-closing' : ''}}" catch:touchmove="noop" catch:tap="onOutsideTap" />
    <view
      class="ll-popover__panel {{closing ? 'll-popover__panel--closing' : ''}} {{placed ? '' : 'is-placing'}}"
      style="{{panelStyle}}{{customStyle}}"
      catch:tap="noop"
      aria-role="dialog"
      aria-label="{{ariaLabel}}"
      aria-modal="false"
    >
      <ll-paper
        stock="{{stock}}"
        edge="{{edge}}"
        tilt="{{tilt}}"
        tape="{{tape}}"
        fastener="{{pin ? 'pin' : false}}"
        fastener-tone="{{pin === true ? '' : pin}}"
        rules="none"
        seed="{{seed}}"
        shadow-css="{{liftShadow}}"
        custom-style="position:relative;display:block;width:100%;padding:{{padding}};box-sizing:border-box;"
      >
        <slot />
      </ll-paper>
      <view
        wx:if="{{arrow}}"
        class="ll-popover__arrow"
        style="{{arrowStyle}}background-image:url('{{arrowUri}}');"
      />
    </view>
  </block>
</view>
