.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx; /* gap-4 */
  margin-bottom: 24rpx;
}
.center-row.wrap {
  flex-wrap: wrap;
}
/* 50-demo heading block: space-y-2 */
.plain-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.2;
}
.plain-desc {
  font-size: 25rpx;
  color: #4a433c;
}
/* grid gap-4 / gap-2 rows */
.stack-16 {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.stack-8 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
/* grid grid-cols-3 items-center gap-4 */
.field-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.form-label {
  width: 25%;
  font-size: 25rpx;
  font-weight: 500;
}
.form-field {
  flex: 1;
}
/* 04: mt-3 grid gap-2; flex gap-2 link row */
.share-grid {
  margin-top: 24rpx; /* mt-3 */
}
.share-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.share-field {
  flex: 1;
}
