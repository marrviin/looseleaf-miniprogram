.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stage {
  position: relative;
  height: 480rpx;
}
.stage-tall {
  height: 560rpx;
}
.stage-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stage-center.row {
  flex-wrap: wrap;
  gap: 24rpx;
  align-content: center;
}
.launch-title {
  font-size: 40rpx;
  color: #2a2420;
}
.task-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.task-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.task-label {
  font-size: 26rpx;
  color: #2a2420;
}
.launch-status {
  margin-top: 28rpx;
  min-height: 48rpx;
  font-size: 30rpx;
  color: #2c4f9e;
}
