/* ll-message-footer — delivery notes under the bubbles */
.ll-message-footer {
  display: flex;
  max-width: 100%;
  min-width: 0;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 14px;
  color: var(--muted-foreground, #4a433c);
}
.ll-message-footer.is-end {
  justify-content: flex-end;
}
