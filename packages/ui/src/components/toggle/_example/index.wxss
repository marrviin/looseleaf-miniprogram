.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.row--wrap {
  flex-wrap: wrap;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 40rpx; /* gap-5 */
  padding: 8rpx 0;
}
.stack--loose {
  gap: 40rpx;
  padding: 0;
}

/* the follow-button card (upstream 03-follow-button: Card, max-w-sm) */
.card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-width: 576rpx; /* max-w-sm */
  padding: 32rpx;
  border: 2rpx solid #e4ded2;
  border-radius: 16rpx;
  background: #fffdf8;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2a2420;
}
.card-desc {
  font-size: 25rpx;
  color: #6f6a60;
}
.card-status {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60;
}
