<!-- ll-bookmark demo — mirrors the upstream docs page
     (#/components/bookmark). The "Page markers" notebook panel needs
     ll-notebook (not in this batch) — only the Paper panel is shown. -->
<view class="demo">
  <ll-page-title underline="highlight" seed="bookmark" custom-style="margin-bottom:16rpx;">Bookmark</ll-page-title>
  <view class="sec-desc">A cloth ribbon bookmark that is a toggle button: a whisper pencil ghost at rest, the woven ribbon when pressed. Press it: the ghost becomes a ribbon that settles in with a little turn.</view>

  <view class="sec sec--desk">
    <view class="sec-h2">Preview</view>
    <view class="sub-h3">A bookmark</view>
    <view class="sec-desc">Press it: the ghost becomes a ribbon. It is a toggle button, so its state is `aria-pressed`.</view>
    <view class="row">
      <ll-bookmark id="bm-off" label="Save for later" seed="off" bindchange="onPreview" />
      <ll-bookmark id="bm-on" label="Saved" seed="on" pressed="{{true}}" />
      <ll-bookmark label="Cannot save" seed="dis" disabled="{{true}}" />
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sec-h2">Examples</view>
    <view class="sub-h3">Eight ribbons</view>
    <view class="sec-desc">Every stationery accent. Each ribbon is woven and edge-stitched, lit from the upper left, a hair off straight.</view>
    <view class="row row--wrap">
      <ll-bookmark wx:for="{{tones}}" wx:key="*this" label="{{item}}" tone="{{item}}" seed="{{item}}" pressed="{{true}}" />
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sub-h3">Page markers</view>
    <view class="sec-desc">`BookmarkRibbon` is the ribbon with no behavior: decoration that hangs out of the top of a sheet. (The notebook panel of the upstream example needs ll-notebook, not ported yet.)</view>
    <view class="row">
      <ll-paper seed="marked" custom-style="position:relative;min-height:282rpx;width:100%;max-width:520rpx;padding:42rpx">
        <ll-bookmark-ribbon seed="r1" custom-style="position:absolute;top:-7rpx;right:42rpx" />
        <view class="script-title">Chapter three</view>
        <view class="body-text">where the ribbon marks the page</view>
      </ll-paper>
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sub-h3">A reading list</view>
    <view class="sec-desc">A real use: save articles for later. Each card holds a Bookmark; the count follows. State lives in your app, as with any toggle.</view>
    <view class="list">
      <view class="count" aria-live="polite">Saved for later: {{count}} of {{articles.length}}</view>
      <view wx:for="{{articles}}" wx:key="id">
        <ll-card
          stock="index-card"
          seed="{{item.id}}"
          tilt="{{item.tilt}}"
          custom-style="position:relative;gap:7rpx;padding:35rpx 24rpx"
        >
          <ll-bookmark
            id="bm-{{item.id}}"
            label="Save: {{item.title}}"
            tone="{{item.tone}}"
            seed="{{item.id}}"
            pressed="{{item.saved}}"
            data-id="{{item.id}}"
            bindchange="onSaved"
            custom-style="position:absolute;top:-7rpx;right:42rpx"
          />
          <ll-card-header custom-style="padding-right:113rpx">
            <ll-card-title>{{item.title}}</ll-card-title>
            <ll-card-description>{{item.meta}}</ll-card-description>
          </ll-card-header>
        </ll-card>
      </view>
    </view>
  </view>
</view>
