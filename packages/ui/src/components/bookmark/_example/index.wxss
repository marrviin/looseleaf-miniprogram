.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 56rpx; /* gap-8 */
  padding: 42rpx; /* p-6 */
}
.row--wrap {
  flex-wrap: wrap;
  justify-content: center;
  gap: 42rpx; /* gap-6 */
}
.script-title {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 42rpx; /* text-2xl */
  line-height: 1;
  font-weight: 700;
}
.body-text {
  margin-top: 14rpx; /* mt-2 */
  font-size: 28rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 56rpx; /* gap-8 */
  max-width: 676rpx; /* max-w-sm */
  margin: 0 auto;
}
.count {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 42rpx; /* text-2xl */
}
