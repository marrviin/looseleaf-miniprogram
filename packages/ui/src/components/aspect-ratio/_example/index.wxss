/* ll-aspect-ratio demo */
.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title { font-weight: bold; font-size: 40rpx; margin-bottom: 8rpx; }
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-desc { font-size: 24rpx; color: #8a857c; line-height: 1.6; margin-bottom: 20rpx; }
.ar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
  align-items: flex-end;
}
.ar-cell {
  width: 280rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.ar-print {
  background: #fdfcf8;
  padding: 8px;
  box-shadow: 0 1px 3px rgba(58, 44, 30, 0.18);
}
.turn-a { transform: rotate(-1deg); }
.turn-b { transform: rotate(1deg); }
.turn-c { transform: rotate(-0.6deg); }
.turn-d { transform: rotate(0.8deg); }
.ar-window {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: inset 0 2px 4px rgba(58, 44, 30, 0.26), inset 0 0 0 1px rgba(58, 44, 30, 0.12);
}
.tint-sky { background: rgba(125, 168, 220, 0.4); }
.tint-lemon { background: rgba(233, 214, 107, 0.45); }
.tint-bubblegum { background: rgba(240, 158, 181, 0.4); }
.tint-grass { background: rgba(120, 180, 120, 0.4); }
.ar-label {
  text-align: center;
  font-size: 24rpx;
  color: #4a433c;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
