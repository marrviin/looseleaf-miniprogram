/* ll-notebook-title — font-script text-[1.75rem] leading-7 font-bold,
   lifted by the rule offset less ~3px so it stands on its rule. */
/* @ll-import tokens */
.ll-notebook-title {
  position: relative;
  top: -5px;
  box-sizing: border-box;
  font-family: 'Kevin Sans', 'PingFang SC', sans-serif; /* font-script */
  font-size: 28px; /* 1.75rem */
  line-height: 28px; /* one ruled line */
  font-weight: 700;
  color: var(--ll-ink, #2a2420);
}
