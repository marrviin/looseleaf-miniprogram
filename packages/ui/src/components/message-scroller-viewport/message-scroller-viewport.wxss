/* ll-message-scroller-viewport — scroll region + paper edge fades */
/* @ll-import tokens */
.ll-message-scroller-viewport {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  min-width: 0;
}
.ll-message-scroller-viewport__scroller {
  width: 100%;
  height: 100%;
}
/* the fade is a paper gradient overlay (upstream: a CSS mask) shown only
   while there is more to scroll at that edge */
.ll-message-scroller-viewport__fade {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 5;
}
.ll-message-scroller-viewport__fade.is-top {
  top: 0;
  height: 20px;
  background: linear-gradient(to bottom, var(--ll-paper, #f8f5ee), rgba(248, 245, 238, 0));
}
.ll-message-scroller-viewport__fade.is-bottom {
  bottom: 0;
  height: 28px;
  background: linear-gradient(to top, var(--ll-paper, #f8f5ee), rgba(248, 245, 238, 0));
}
