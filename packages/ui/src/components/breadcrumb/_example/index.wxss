.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center { display: flex; justify-content: center; }
.grid-gap { margin-top: 16rpx; display: flex; flex-direction: column; gap: 40rpx; }
.grid-gap-lg { margin-top: 16rpx; display: flex; flex-direction: column; gap: 48rpx; }
.row { display: flex; align-items: center; gap: 32rpx; flex-wrap: wrap; }
/* upstream DropdownMenuTrigger className="-mx-1 flex items-center gap-1 px-1" */
.crumb-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 -8rpx;
  padding: 0 8rpx;
}
/* File path (composed): the Paper backdrop */
.path-paper {
  width: 100%;
  max-width: 576rpx;
  padding: 40rpx;
  background: #fbf8f1;
  border: 1rpx solid #e4dfd3;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.folder-list {
  margin-top: 32rpx;
  display: grid;
  gap: 8rpx;
}
.folder-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 16rpx;
  margin: 0 -8rpx;
  font-size: 26rpx;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.folder-empty {
  font-size: 24rpx;
  color: #8a857c;
}
.mono {
  font-family: monospace;
  font-size: 24rpx;
  color: #8a857c;
}
