.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; padding: 32rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center { display: flex; justify-content: center; }
.grid-gap { margin-top: 16rpx; display: flex; flex-direction: column; gap: 40rpx; }
.grid-gap-lg { margin-top: 16rpx; display: flex; flex-direction: column; gap: 48rpx; }
.row { display: flex; align-items: center; gap: 32rpx; flex-wrap: wrap; }
/* upstream DropdownMenuTrigger className="-mx-1 flex items-center gap-1 px-1" */
.crumb-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 -8rpx;
  padding: 0 8rpx;
}
/* File path (composed): the Paper backdrop */
.path-paper {
  width: 100%;
  max-width: 576rpx;
  padding: 40rpx;
  background: #fbf8f1;
  border: 1rpx solid #e4dfd3;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.folder-list {
  margin-top: 32rpx;
  display: grid;
  gap: 8rpx;
}
.folder-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 16rpx;
  margin: 0 -8rpx;
  font-size: 26rpx;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.folder-empty {
  font-size: 24rpx;
  color: #8a857c;
}
.mono {
  font-family: monospace;
  font-size: 24rpx;
  color: #8a857c;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
