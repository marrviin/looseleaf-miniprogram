/* ll-receipt-barcode — figure flex flex-col items-center gap-1.5;
   figcaption ll-num text-xs tracking-[0.3em] */
.ll-receipt-barcode {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 11rpx; /* gap-1.5 */
  width: 100%;
}

.ll-receipt-barcode-bars {
  width: 100%;
}

.ll-receipt-barcode-caption {
  font-size: 18rpx; /* text-xs 11px x .82 */
  letter-spacing: 0.3em; /* tracking-[0.3em] */
  font-variant-numeric: tabular-nums lining-nums; /* .ll-num */
}
