.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 32rpx; /* upstream examples use gap-4 */
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}
.state-group {
  margin-bottom: 24rpx;
}
/* Size pairs: each pair tight (gap-4), pairs separated by gap-x-10 (80rpx). */
.row-pairs {
  gap: 80rpx;
}
.pair {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.state-label {
  font-size: 28rpx;
  font-style: italic;
  color: #2c4f9e; /* --ll-ink-you, upstream state labels use font-script text-ink-you */
  margin-bottom: 12rpx;
}
.status {
  font-size: 26rpx;
  color: #8a857c;
}
