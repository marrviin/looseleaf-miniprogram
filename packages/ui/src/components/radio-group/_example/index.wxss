.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 40rpx; /* gap-5 */
  padding: 8rpx 0;
}
.stack--tight {
  gap: 24rpx; /* gap-3 */
  padding: 0;
}
.stack--plans {
  gap: 48rpx; /* gap-6 */
}
.row--plan {
  align-items: flex-start; /* items-start */
}
.stack--plan-text {
  gap: 8rpx; /* gap-1 */
  padding: 0;
}
.row--bill {
  gap: 20rpx; /* gap-2.5 */
}
.size-label {
  width: 112rpx; /* w-14 */
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60; /* text-ink-muted */
}
.label {
  font-size: 28rpx;
  color: #2a2420;
}
.help {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60; /* text-ink-muted */
}
.form {
  max-width: 608rpx; /* max-w-sm */
}
.form-legend {
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 8rpx;
}
.row--vote {
  margin-top: 8rpx;
}
.status {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60;
}
