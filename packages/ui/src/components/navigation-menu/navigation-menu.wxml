<!-- ll-navigation-menu — nav landmark; the shared viewport slip hangs from
     under the strip and is resized to the open panel. -->
<view class="ll-navigation-menu {{vp ? 'll-navigation-menu--vp' : ''}} {{value ? 'll-navigation-menu--open' : ''}} ll-class" style="{{customStyle}}" aria-role="navigation" aria-label="{{ariaLabel}}">
  <slot />
  <view wx:if="{{vp && slipW}}" class="ll-navigation-menu__slip" style="width:{{slipW}}px;height:{{slipH}}px;">
    <ll-paper stock="slip" tilt="{{0.3}}" rules="none" custom-style="position:absolute;inset:0;" />
  </view>
</view>
