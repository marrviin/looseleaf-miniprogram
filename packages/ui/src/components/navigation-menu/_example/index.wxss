/* ll-navigation-menu demo */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 8rpx 0;
}
.script {
  font-family: 'Kevin Sans', sans-serif; /* the hand/script display font */
}

/* 01/50 Getting started panel: featured card + rows
   (upstream grid gap-2 lg:grid-cols-[.75fr_1fr], width to phone) */
.nav-grid {
  display: grid;
  gap: 16rpx; /* gap-2 */
}
.nav-grid--gs {
  width: 660rpx;
  grid-template-columns: 0.75fr 1fr;
}
.nav-grid--two {
  width: 640rpx;
  grid-template-columns: 1fr 1fr;
}
.nav-grid--links {
  width: 384rpx; /* w-48 */
  gap: 8rpx; /* gap-1 */
}
.nav-grid--header {
  width: 480rpx; /* w-60 */
  gap: 8rpx;
}

/* the featured card (upstream bg-card p-4 shadow-loose flex-col justify-end) */
.feature {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32rpx; /* p-4 */
  background: var(--ll-card, #fbf6e9);
  box-shadow: 0 1px 1.5px rgba(58, 44, 30, 0.2), 0 6px 11px -5px rgba(58, 44, 30, 0.24);
}
.feature__title {
  font-size: 48rpx; /* text-2xl */
  line-height: 1;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.feature__head {
  font-size: 34rpx; /* text-lg */
  font-weight: 500;
  margin-bottom: 8rpx;
}
.feature__desc {
  font-size: 24rpx; /* text-sm */
  line-height: 1.35;
  color: var(--muted-foreground, #4a433c);
}

.bold {
  font-weight: 700;
}
.muted {
  font-size: 24rpx; /* text-sm */
  line-height: 1.35;
  color: var(--muted-foreground, #4a433c);
}
.row-with-icon {
  display: flex;
  align-items: center;
  gap: 16rpx; /* gap-2 */
}

/* 04 site header (upstream header flex flex-wrap items-end gap-x-4) */
.header {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 16rpx 32rpx; /* gap-x-4 gap-y-2 */
  padding: 24rpx 40rpx 32rpx; /* px-5 pt-3 pb-4 */
}
.header__logo {
  display: flex;
  align-items: center;
  gap: 16rpx; /* gap-2 */
  align-self: center;
  font-size: 48rpx; /* text-2xl */
  line-height: 1;
  font-weight: 600;
}
.header__actions {
  display: flex;
  align-items: center;
  gap: 16rpx; /* gap-2 */
  align-self: center;
  margin-left: auto; /* ms-auto */
}
