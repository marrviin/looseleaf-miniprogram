/* ll-skeleton demo — shared demo base + skeleton-specific bits. */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}
.col {
  display: flex;
  flex-direction: column;
}
.col-2 {
  gap: 16rpx; /* gap-2 */
}
.col-6 {
  gap: 48rpx; /* gap-6 */
}
.row {
  display: flex;
}
.row-gap {
  gap: 32rpx; /* gap-4 (space-x-4 / gap-3 approximated) */
}
.row-center {
  align-items: center;
}

/* 03: rows keep their height across the swap (upstream min-h-[3.25rem]) */
.loaded-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 104rpx;
}
.loaded-title {
  font-weight: 700;
  color: var(--ink, #2a2420);
}
.loaded-body {
  font-size: 26rpx;
  line-height: 1.375;
  color: var(--muted-foreground, #4a433c);
}
