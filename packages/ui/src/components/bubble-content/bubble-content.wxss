/* ll-bubble-content — the drawn body: ink behind, text above */
/* @ll-import tokens */
.ll-bubble-content {
  position: relative;
  isolation: isolate;
  width: fit-content;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
/* text: px-4 py-2.5, hand font, relaxed leading */
.ll-bubble-content__text {
  position: relative;
  padding: 10px 16px;
  font-family: 'Kevin Sans', sans-serif; /* font-hand */
  font-size: 16px;
  line-height: 1.625; /* leading-relaxed */
  word-break: break-word;
  white-space: pre-wrap;
}
.ll-bubble-content.is-ghost .ll-bubble-content__text {
  padding: 0;
}
/* pen="you": the script face in blue felt */
.ll-bubble-content.is-you .ll-bubble-content__text {
  font-size: 21.6px; /* text-[1.35rem] */
  line-height: 1.375; /* leading-snug */
}
/* note/sticky sheets: script face (crease gradient only on `note`) */
.ll-bubble-content__text.is-script {
  padding: 10px 16px;
  font-size: 21.6px;
  line-height: 1.375;
}
.ll-bubble-content__creases {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  /* upstream CREASES ::after with the tokens precomputed (color-mix is
     unsupported in the webview) */
  background: linear-gradient(
    90deg,
    transparent 31.6%,
    rgba(58, 44, 30, 0.16) 32.2%,
    rgba(255, 253, 246, 0.5) 32.9%,
    transparent 35.5%,
    transparent 64%,
    rgba(58, 44, 30, 0.12) 64.6%,
    rgba(255, 253, 246, 0.45) 65.3%,
    transparent 68%
  );
}
