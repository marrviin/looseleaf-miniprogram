.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 8rpx 0;
}

.kind-grid {
  display: flex;
  flex-wrap: wrap;
  column-gap: 64rpx; /* gap-x-8 */
  row-gap: 48rpx; /* gap-y-6 */
  padding: 32rpx 0;
}
.kind-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  width: 40%;
}
.kind-name {
  font-size: 25rpx;
  color: #8a857c;
}
.strip-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.prop-abs {
  position: absolute;
  z-index: 3;
  pointer-events: none;
}
.taped-title {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 700;
  color: #2a2420;
}
.taped-body {
  font-size: 26rpx;
  line-height: 53rpx;
  color: #57534e;
}

.label-wrap {
  position: relative;
  display: inline-block;
  width: 264rpx;
}
.label-text {
  position: relative;
  z-index: 3;
  width: 264rpx;
  text-align: center;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 42rpx;
  line-height: 64rpx;
  font-weight: 700;
  color: #2a2420;
}
