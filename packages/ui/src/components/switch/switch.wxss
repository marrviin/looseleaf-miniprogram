/* @ll-import tokens */
.ll-switch {
  position: relative;
  isolation: isolate;
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  width: 88rpx; /* w-11 */
  height: 48rpx; /* h-6 */
  box-sizing: border-box;
}
.ll-switch--sm {
  width: 72rpx; /* w-9 */
  height: 40rpx; /* h-5 */
}
/* upstream after:-inset-1 — the finger target is 4px larger on every side */
.ll-switch::after {
  content: '';
  position: absolute;
  inset: -8rpx;
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
.ll-switch-thumb {
  position: absolute;
  left: 0;
  top: 8rpx; /* (track h - thumb h) / 2 = 4px at both sizes */
  z-index: 1;
  pointer-events: none;
  transition: transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.15); /* --ll-dur-pop / --ll-ease-pop */
}
