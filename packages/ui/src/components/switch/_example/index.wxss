.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.row--between {
  justify-content: space-between; /* flex items-center justify-between gap-4 */
}
.row--locked {
  margin-top: 32rpx; /* gap-4 below the grid */
}
.grid {
  display: flex;
  flex-direction: column;
  gap: 28rpx; /* gap-y-3.5 */
}
.grid-row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-x-3 */
}
.grid-row--head {
  align-items: baseline;
}
.grid-name {
  width: 112rpx; /* 3.5rem */
  flex-shrink: 0;
  font-size: 28rpx;
  color: #6f6a60;
}
.grid-col {
  width: 200rpx; /* 5rem */
  flex-shrink: 0;
  font-size: 26rpx; /* text-[13px] × 0.88 */
  line-height: 1.25;
  color: #6f6a60; /* text-ink-muted */
  white-space: nowrap;
}
.label {
  font-size: 28rpx;
  color: #2a2420;
}
.label--dim {
  color: #8a857c; /* peer-disabled fade */
}
.settings {
  width: 100%;
  max-width: 896rpx; /* max-w-md */
}
.setting {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 48rpx; /* gap-6 */
  padding: 28rpx 0; /* py-3.5 */
  border-bottom: 1rpx solid rgba(44, 79, 158, 0.35); /* divide-rule-blue/60 */
}
.setting:last-child {
  border-bottom: none;
}
.setting-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx; /* gap-1 */
}
.help {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60; /* text-ink-muted */
}
.stack--form {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* gap-4 */
  max-width: 608rpx; /* max-w-sm */
}
.status {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60;
}
