<!-- ll-sticker-sheet demo — mirrors the upstream docs page
     (#/components/sticker-sheet). The third upstream example ("Sheet to
     board") needs ll-sticker-board — deferred like napkin's 03 was. -->
<view class="demo">
  <view class="demo-title">Sticker sheet</view>
  <view class="sec-desc">A kiss-cut sheet: press a sticker and it lifts off, leaving its cut outline behind. Press the outline to stick it back. Touch one and its corner curls.</view>

  <view class="sec">
    <view class="sec-h2">Preview</view>
    <view class="sub-h3">A sheet to peel</view>
    <view class="sec-desc">Press a sticker (or Enter) and it lifts off, leaving its kiss-cut outline behind. Press the outline to stick it back. Hover one and its corner curls.</view>
    <view class="row">
      <ll-sticker-sheet id="sheet-one" title="Sticker sheet no. 4" stickers="{{names}}" default-peeled="{{['done', 'hundred']}}" bindpeel="onPeel" bindstick="onStick" />
    </view>
    <view wx:if="{{log}}" class="sheet-log" aria-role="status">{{log}}</view>
  </view>

  <view class="sec">
    <view class="sec-h2">Examples</view>
    <view class="sub-h3">Backing paper and size</view>
    <view class="sec-desc">The backing is release paper with a sheen (glassine, the default), kraft or plain paper. Columns and size set the grid; shorthand `stickers` skips the items when you do not need labels or ids.</view>
    <view class="row row--wrap">
      <ll-sticker-sheet title="Badges" columns="{{3}}" size="{{64}}" stickers="{{badges}}" default-peeled="{{['beta']}}" />
      <ll-sticker-sheet title="Kraft" backing="kraft" columns="{{3}}" size="{{64}}" stickers="{{kraftNames}}" />
      <ll-sticker-sheet title="Plain" backing="paper" columns="{{2}}" size="{{80}}" stickers="{{plain}}" />
    </view>
  </view>

  <!-- "Sheet to board" (upstream example 03) needs ll-sticker-board —
       deferred until that component lands. -->
</view>
