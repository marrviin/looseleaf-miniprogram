/* ll-notebook-cover-label — w-full px-3 py-2 text-center font-script
   text-xl leading-tight font-bold text-ink. */
/* @ll-import tokens */
.ll-notebook-cover-label {
  box-sizing: border-box;
  width: 100%;
  padding: 8px 12px;
  text-align: center;
  font-family: 'Kevin Sans', 'PingFang SC', sans-serif; /* font-script */
  font-size: 20px; /* text-xl */
  line-height: 1.25;
  font-weight: 700;
  color: var(--ll-ink, #2a2420);
}
