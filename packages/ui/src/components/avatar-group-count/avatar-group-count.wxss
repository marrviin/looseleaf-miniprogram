/* ll-avatar-group-count — same box and type scale as the avatar it trails. */
.ll-avatar-group-count {
  position: relative;
  z-index: 0; /* isolate */
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 25rpx; /* text-sm × 0.88 */
  font-weight: 700;
  color: var(--ll-ink-soft, #4a423b); /* text-ink-soft */
  box-shadow: 0 0 0 4rpx var(--ll-avatar-ring, transparent); /* upstream CUT */
  margin-left: var(--ll-avatar-overlap, 0);
}
.ll-avatar-group-count--sm {
  width: 48rpx;
  height: 48rpx;
  font-size: 21rpx;
}
.ll-avatar-group-count--lg {
  width: 80rpx;
  height: 80rpx;
  font-size: 28rpx;
}
.ll-avatar-group-count--xl {
  width: 112rpx;
  height: 112rpx;
  font-size: 35rpx;
}
.ll-avatar-group-count__content {
  position: relative;
  z-index: 1;
  line-height: 1;
}
.ll-avatar-group-count .ll-ink-layer {
  position: absolute;
  pointer-events: none;
  background-size: 100% 100%;
  background-repeat: no-repeat;
}
