.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* gap-3 */
  padding: 8rpx 0;
}
.stack--loose {
  gap: 40rpx; /* gap-5 */
}

/* Bubble placeholder until ll-bubble lands (upstream Bubble muted/default). */
.bubble {
  max-width: 80%;
  padding: 16rpx 28rpx;
  border-radius: 18rpx 18rpx 18rpx 4rpx;
  background: #ece6da; /* --ll-paper-shade */
  font-family: 'Kevin Sans', sans-serif;
  font-size: 26rpx;
  color: #2a2420;
}
.bubble--end {
  margin-left: auto;
  border-radius: 18rpx 18rpx 4rpx 18rpx;
  background: #fffdf6; /* --ll-photo */
}
