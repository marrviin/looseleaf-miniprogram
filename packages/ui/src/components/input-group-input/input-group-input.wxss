/* ll-input-group-input — the bare input: transparent, fills the box
   between the addons; the group's ink draws behind it. */
/* @ll-import tokens */

.ll-igi {
  flex: 1;
  width: 100%;
  height: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: 8rpx 24rpx; /* py-1 px-3 */
  font-size: inherit;
  color: var(--ll-input-ink, #2c4f9e); /* what you type is blue felt */
  caret-color: var(--ll-caret, #2c4f9e);
  background: transparent;
}
.ll-igi__placeholder {
  color: var(--ll-placeholder, #5a554e); /* graphite */
}
.ll-igi--disabled {
  color: #5a554e; /* disabled:text-pencil-text */
}
