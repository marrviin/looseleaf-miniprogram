<!-- ll-field-error — red message(s) over a wavy red pencil underline;
     renders nothing when there is nothing to say. -->
<view
  wx:if="{{hasContent}}"
  class="ll-field-error ll-class"
  style="{{customStyle}}"
  aria-role="alert"
>
  <view class="ll-ink-layer" style="{{inkStyle}}" />
  <block wx:if="{{listed}}">
    <view class="ll-field-error__row" wx:for="{{messages}}" wx:key="*this">
      <view class="ll-field-error__dot" />
      <text class="ll-field-error__text">{{item}}</text>
    </view>
  </block>
  <text wx:elif="{{messages.length}}" class="ll-field-error__text">{{messages[0]}}</text>
  <view wx:else class="ll-field-error__slot"><slot /></view>
</view>
