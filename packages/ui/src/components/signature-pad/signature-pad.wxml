<!-- ll-signature-pad — an ll-sketchpad (single pen, slip stock, hair
     shadow, no toolbar) with the Guides layered over it: the baseline rule,
     the typed hand-lettering or an externally-set value image, and the
     "Sign here" hint. The typed input and the Clear / mode-toggle row sit
     under the canvas. Upstream's hidden form input doesn't port — the page
     owns validation and passes `invalid`. -->
<view class="ll-signature ll-class {{invalidNow ? 'is-invalid' : ''}} {{disabled ? 'is-disabled' : ''}}" style="{{customStyle}}">
  <view class="ll-signature-canvas">
    <ll-sketchpad
      class="ll-signature__pad"
      value="{{padStrokes}}"
      tool="{{pen}}"
      color="{{penColor}}"
      size="{{penSize}}"
      show-toolbar="{{false}}"
      width="{{width}}"
      height="{{height}}"
      paper="plain"
      stock="slip"
      shadow="hair"
      label="{{label}}"
      read-only="{{readOnly || mode === 'type'}}"
      disabled="{{disabled}}"
      bind:change="onPadChange"
    />
    <view class="ll-signature__overlay">
      <view wx:if="{{baselineStyle}}" class="ll-signature__baseline" style="{{baselineStyle}}"></view>
      <view wx:if="{{overlayStyle}}" class="ll-signature__img" style="{{overlayStyle}}"></view>
      <text wx:if="{{placeholder}}" class="ll-signature__hint" aria-hidden="{{true}}">{{placeholderText}}</text>
    </view>
  </view>
  <view wx:if="{{mode === 'type' && !readOnly}}" class="ll-signature__typed">
    <input
      class="ll-signature__input"
      value="{{typedStr}}"
      placeholder="Type your full name"
      aria-label="Type your full name"
      disabled="{{disabled}}"
      focus="{{typedFocus}}"
      bindinput="onTyped"
    />
  </view>
  <view wx:if="{{!readOnly}}" class="ll-signature__actions">
    <ll-button variant="ghost" size="sm" disabled="{{disabled || !canClear}}" bind:tap="onClear">Clear</ll-button>
    <ll-button wx:if="{{typedFallback}}" variant="link" size="sm" disabled="{{disabled}}" bind:tap="onToggleMode">{{mode === 'type' ? 'Draw instead' : 'Type instead'}}</ll-button>
  </view>
  <text wx:if="{{invalidNow}}" class="ll-signature__message" aria-role="alert">{{message}}</text>
</view>
