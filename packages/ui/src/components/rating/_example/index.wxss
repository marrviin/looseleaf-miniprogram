.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 40rpx; /* gap-5 */
  padding: 8rpx 0;
}
.stack--tight {
  gap: 16rpx; /* gap-2 */
  padding: 0;
}
.col-start {
  align-items: flex-start;
}
.col-center {
  align-items: center;
}
.wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 64rpx; /* gap-x-8 */
  row-gap: 24rpx; /* gap-y-3 */
}
.label {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #2a2420;
}
.live {
  font-family: 'Kevin Sans', sans-serif; /* font-hand */
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
.survey {
  max-width: 768rpx; /* max-w-sm */
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx; /* gap-4 */
}
.row-label {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 30rpx; /* text-[15px] × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
