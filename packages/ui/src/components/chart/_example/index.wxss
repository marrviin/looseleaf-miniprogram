.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.said-line {
  font-size: 25rpx;
  color: #4a433c;
}
.col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.col--stack {
  gap: 32rpx;
}
.row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pair {
  display: flex;
  flex-wrap: wrap;
  gap: 40rpx;
}
.pair > .pie-wrap {
  flex: 1 1 280rpx;
  min-width: 280rpx;
}
.pair > .tile {
  flex: 1 1 280rpx;
  min-width: 280rpx;
}
.note-line {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.note-line.is-up {
  color: #3f7d44;
}
.note-line.is-down {
  color: #b3402f;
}
