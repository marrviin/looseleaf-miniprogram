/* ll-tabs-trigger */
/* @ll-import tokens */
.ll-tabs-trigger {
  position: relative;
  isolation: isolate;
  display: inline-flex;
  flex: 1;
  height: 72rpx; /* h-9 */
  align-items: center;
  justify-content: center;
  gap: 12rpx; /* gap-1.5 */
  padding: 0 32rpx 4rpx; /* px-4 + data-[orientation=horizontal]:pt-1 */
  box-sizing: border-box;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 26rpx; /* text-[15px] x .88 */
  font-weight: 700;
  white-space: nowrap;
  color: var(--muted-foreground); /* text-muted-foreground */
  transition: translate 160ms ease, color 160ms ease; /* duration-(--ll-dur-hover) */
}
.ll-tabs-trigger--vertical {
  width: 100%;
  justify-content: flex-start; /* data-[orientation=vertical]:justify-start */
  padding: 4rpx 0; /* pt-0.5 */
}
/* variant default: the active tab lifts off the baseline */
.ll-tabs-trigger--active.ll-tabs-trigger--horizontal {
  translate: 0 -4rpx; /* data-[state=active]:-translate-y-0.5 */
}
.ll-tabs-trigger--active.ll-tabs-trigger--vertical {
  translate: 4rpx 0; /* data-[orientation=vertical]:translate-x-0.5 */
}
.ll-tabs-trigger--disabled {
  pointer-events: none;
  color: var(--ll-pencil-text); /* disabled:text-pencil-text */
}
.ll-tabs-trigger__content {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
