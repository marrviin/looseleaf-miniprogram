.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
/* 01: the graph-sheet trigger region */
.region-script {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 48rpx; /* text-2xl ×0.88 */
  color: #2a2420;
}
.region-sub {
  font-size: 25rpx; /* text-sm ×0.88 */
  color: #8a857c;
  margin-top: 4rpx;
}
/* 02: the notebooks card */
.files-script {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 48rpx; /* text-2xl ×0.88 */
  font-weight: 600;
  line-height: 1.1;
  color: #2a2420;
}
.files-list {
  margin-top: 12rpx;
  display: grid;
  gap: 4rpx; /* gap-0.5 */
}
.files-row-wrap {
  display: block;
}
.files-row {
  display: flex;
  align-items: center;
  gap: 20rpx; /* gap-2.5 */
  padding: 12rpx 16rpx; /* px-2 py-1.5 */
  font-size: 28rpx;
  color: #2a2420;
}
.files-note {
  margin-top: 12rpx;
  border-top: 1px dashed rgba(58, 44, 30, 0.6); /* border-dashed border-pencil-mark/60 */
  padding-top: 8rpx;
  font-size: 25rpx; /* text-sm ×0.88 */
  color: #8a857c;
}
/* 03: the sticky note */
.note-script {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 48rpx; /* text-2xl ×0.88 */
  line-height: 1.25;
  color: #2a2420;
}
.note-sub {
  margin-top: 8rpx;
  font-size: 25rpx; /* text-sm ×0.88 */
  color: rgba(58, 44, 30, 0.8); /* text-ink-soft */
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
