/* ll-avatar-image — round, covers the avatar box. The WRAPPER does the
   stacking (position + z-index above the fallback) because wx-image ignores
   z-index/position overrides; aspectFill (mode) does the object-cover work. */
.ll-avatar-image-wrap {
  position: relative;
  z-index: 2;
  display: block;
  flex-shrink: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
}
.ll-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}
