<!-- ll-circled — the text is rendered as inline word spans so the mark
     behavior can measure the phrase box; the loop is an absolute z-index:1
     layer in front of the words. Until the ink is ready the host shows a
     pencil outline (upstream outline-1 outline-pencil-mark offset-2). -->
<view class="ll-mark ll-circled ll-class {{show && !markReady ? 'll-circled--fallback' : 'll-circled--ink-on'}}" style="{{customStyle}}">
  <text class="ll-mark__w" wx:for="{{markWords}}" wx:key="index">{{item}}</text>
  <view wx:for="{{markInk}}" wx:key="index" class="ll-mark__ink" style="{{item}}" />
</view>
