.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  max-width: 768rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* upstream text-[17px] leading-[1.55] × 0.88 */
.para {
  font-size: 30rpx;
  line-height: 1.55;
  color: #2a2420;
}
/* upstream 02: leading-[2] */
.para.loose,
.loose .para {
  line-height: 2;
}
/* upstream: flex flex-wrap gap-x-6 */
.pens-row {
  display: flex;
  flex-wrap: wrap;
  column-gap: 48rpx;
  row-gap: 24rpx;
  font-size: 30rpx;
  color: #2a2420;
}
/* upstream font-script text-2xl */
.quiz-script {
  font-family: var(--font-script, cursive);
  font-size: 44rpx;
  color: #2a2420;
}
/* upstream: grid gap-2.5 text-[17px] */
.quiz-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  font-size: 30rpx;
  color: #2a2420;
}
/* upstream font-script text-4xl font-bold */
.title-script {
  font-family: var(--font-script, cursive);
  font-size: 68rpx;
  font-weight: 700;
  color: #2a2420;
}
/* upstream: flex flex-wrap items-baseline gap-x-8 text-[17px] */
.bleed-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 64rpx;
  row-gap: 24rpx;
  font-size: 30rpx;
  color: #2a2420;
}
