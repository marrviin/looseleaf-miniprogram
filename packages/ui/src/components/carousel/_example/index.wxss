/* ll-carousel demo */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title { font-weight: bold; font-size: 40rpx; margin-bottom: 8rpx; }
.sec { margin-top: 40rpx; }
.sub-h3 { font-size: 30rpx; font-weight: 700; color: #2a2420; margin: 20rpx 0 6rpx; }
.sec-desc { font-size: 24rpx; color: #8a857c; line-height: 1.6; margin-bottom: 16rpx; }
.ca-frame {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.ca-card {
  height: 150px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ca-card.is-wide { height: 112px; }
.ca-card.is-short { height: 80px; }
.ca-num {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 48px;
  font-weight: 600;
  color: #2a2420;
}
.ca-note {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 20px;
  font-weight: 600;
  color: #2a2420;
  text-align: center;
  line-height: 1.3;
}
.ca-caption {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a857c;
}
