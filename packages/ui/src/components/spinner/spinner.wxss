.ll-spinner {
  position: relative;
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}
.ll-spinner__art {
  position: absolute;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  pointer-events: none;
}

/* write variant: three Stubby frames, opacity-flipped like upstream's
   ll-write-1/2/3 keyframes (lap = 1.08s linear infinite). */
@keyframes ll-write-1 {
  0%,
  33.2% {
    opacity: 1;
  }
  33.3%,
  100% {
    opacity: 0;
  }
}
@keyframes ll-write-2 {
  0%,
  33.2% {
    opacity: 0;
  }
  33.3%,
  66.5% {
    opacity: 1;
  }
  66.6%,
  100% {
    opacity: 0;
  }
}
@keyframes ll-write-3 {
  0%,
  66.5% {
    opacity: 0;
  }
  66.6%,
  100% {
    opacity: 1;
  }
}
.ll-spinner__frame {
  position: absolute;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  pointer-events: none;
  opacity: 0;
}
.ll-spinner--write .ll-spinner__frame--3 {
  opacity: 1;
}
.ll-spinner--write .ll-spinner__frame--1 {
  animation: ll-write-1 1.08s linear infinite;
}
.ll-spinner--write .ll-spinner__frame--2 {
  animation: ll-write-2 1.08s linear infinite;
}
.ll-spinner--write .ll-spinner__frame--3 {
  animation: ll-write-3 1.08s linear infinite;
}
