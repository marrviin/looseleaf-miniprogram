.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
}
.row--wrap {
  flex-wrap: wrap;
}
.row--gap4 {
  gap: 32rpx; /* gap-4 */
}
.row--gap6 {
  gap: 48rpx; /* gap-6 */
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 48rpx; /* gap-6 */
  padding: 8rpx 0;
}
.cards2 {
  display: flex;
  flex-direction: column;
  gap: 48rpx; /* gap-6, sm:grid-cols-2 collapses on the phone width */
  max-width: 1152rpx; /* max-w-2xl */
  margin: 0 auto;
}
