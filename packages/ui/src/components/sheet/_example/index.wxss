.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a2420;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #37503f;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.grid-cols2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
/* 03/50 fields — stacked label + input like upstream's grid gap-6 px-4 */
.fields {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  padding: 0 32rpx;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.field-label {
  font-size: 26rpx;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.ta-end {
  text-align: end;
}
/* 51-side: grid-cols-4 label + col-span-3 input */
.side-fields {
  gap: 32rpx;
  padding: 32rpx;
}
.side-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.side-row .field-label {
  width: 25%;
}
.side-field {
  flex: 1;
  min-width: 0;
}
/* 02-bindings note list — upstream ul -mt-0.5 space-y-0 px-6 text-base/7 */
.notes {
  padding: 0 48rpx;
  font-size: 30rpx;
  line-height: 1.75;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
/* 04-navigation list — min-h-0 flex-1 overflow-y-auto px-4 py-3, gap-1 */
.nav-list {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}
.nav-list-inner {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
