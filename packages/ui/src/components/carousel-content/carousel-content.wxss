/* ll-carousel-content — overflow hidden; the track carries the slide */
.ll-carousel-content {
  overflow: hidden;
  min-width: 0;
}
.ll-carousel-content__track {
  display: flex;
  flex-direction: row;
  /* upstream -ms-4: the track starts 16px before the viewport so the first
     slide's own ps-4 padding brings its content flush to the edge */
  margin-left: -16px;
  transition: transform 0.3s ease-out;
}
.ll-carousel-content.is-vertical .ll-carousel-content__track {
  flex-direction: column;
  height: 100%;
  margin-left: 0;
  margin-top: -16px;
}
