.ll-sidebar-menu-badge {
  position: absolute;
  top: 12rpx; /* top-1.5 (default-size button) */
  right: 8rpx; /* end-1 */
  display: flex;
  height: 40rpx; /* h-5 */
  min-width: 40rpx; /* min-w-5 */
  align-items: center;
  justify-content: center;
  padding: 0 8rpx; /* px-1 */
  box-sizing: border-box;
  font-family: 'Kevin Sans', sans-serif; /* font-script — Kevin Sans stands in */
  font-size: 32rpx; /* text-lg x .88 */
  line-height: 1;
  font-weight: 600;
  color: #2c4f9e; /* text-ink-you */
  pointer-events: none;
  user-select: none;
  font-variant-numeric: tabular-nums;
}
