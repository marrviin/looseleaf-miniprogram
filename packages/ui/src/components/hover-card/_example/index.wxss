.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx; /* gap-4 */
  margin-bottom: 24rpx;
}
/* trigger + prose on one baseline (upstream: flex items-center gap-1) */
.prose-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 32rpx; /* text-base x .88 */
  color: #2a2420;
  flex-wrap: wrap;
}
.mentions {
  font-size: 32rpx; /* text-base/7 x .88 */
  line-height: 1.9; /* /7 */
  color: #2a2420;
  max-width: 560rpx;
}
/* the small muted line under the caption (px-1 text-sm text-muted-foreground) */
.card-note {
  padding-left: 8rpx;
  padding-right: 8rpx;
  font-size: 25rpx; /* text-sm x .88 */
  line-height: 1.5;
  color: #8a857c;
}
/* 50-demo: avatar + body row (flex justify-between gap-4) */
.plain-row {
  display: flex;
  gap: 16rpx; /* gap-4 */
  align-items: flex-start;
}
.plain-body {
  flex: 1;
  min-width: 0;
}
.plain-name {
  font-size: 25rpx; /* text-sm x .88 */
  font-weight: 600;
  color: #2a2420;
  margin-bottom: 4rpx;
}
.plain-text {
  font-size: 25rpx;
  line-height: 1.5;
  color: #2a2420;
  margin-bottom: 8rpx;
}
.plain-meta {
  display: flex;
  align-items: center;
  gap: 8rpx; /* gap-1 */
  font-size: 22rpx; /* text-xs x .88 */
  color: #8a857c;
}
