/* ll-hover-card — upstream hover-card.tsx: a photo slip anchored to its
   trigger. Pop in: fade + zoom-in-95 + slide-from-side-2 over
   --ll-dur-pop (0.18s); out: fade + zoom-out-95. */
/* @ll-import tokens */

.ll-hover-card {
  display: inline-block;
}

.ll-hover-card__trigger {
  display: inline-block;
}

/* transparent full-screen catcher under the panel (z --ll-z-popover: 1010) */
.ll-hover-card__catcher {
  position: fixed;
  inset: 0;
  z-index: 1010;
  background: transparent;
}

.ll-hover-card__panel {
  position: fixed;
  z-index: 1011;
  max-width: calc(100vw - 16rpx); /* max-w-[calc(100vw-1rem)] */
  font-family: 'Kevin Sans', sans-serif;
  color: #2a2420; /* text-popover-foreground = --ll-ink */
  opacity: 1;
  transform: scale(1);
  animation: ll-hover-card-in 180ms cubic-bezier(0.2, 0.9, 0.3, 1.15) both;
}
.ll-hover-card__panel.is-placing {
  opacity: 0;
  animation: none;
  transition: none;
}
.ll-hover-card__panel--closing {
  animation: ll-hover-card-out 150ms ease-in both;
}

@keyframes ll-hover-card-in {
  0% {
    opacity: 0;
    transform: scale(0.95) translateY(-8px);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}
@keyframes ll-hover-card-out {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: scale(0.95);
  }
}
