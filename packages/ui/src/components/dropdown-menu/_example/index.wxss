.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
.center-col {
  display: flex;
  flex-direction: column;
}
.stack-12 {
  gap: 24rpx;
}
.stack-16 {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.stack-8 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.stack-4 {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
/* 02: the state line under the View menu (text-sm text-muted-foreground) */
.state-line {
  font-size: 25rpx;
  color: #4a433c;
}
/* 04: the notebooks card (w-full max-w-sm) + row list (grid gap-1) */
.rows-card {
  width: 100%;
  max-width: 564rpx; /* max-w-sm */
}
.rows-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 0; /* py-0.5 */
}
.rows-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: #2a2420;
}
/* 52: dialog form rows */
.dlg-form {
  padding-bottom: 8rpx;
}
.form-label {
  font-size: 25rpx;
  font-weight: 500;
  color: #2a2420;
}
