.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 56rpx; /* gap-7 */
  padding: 8rpx 0;
}
.stack--tight {
  gap: 16rpx; /* gap-2 */
  padding: 0;
}
.col-start {
  align-items: flex-start;
}
.col-center {
  align-items: center;
}
.label {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #2a2420;
}
.live {
  font-family: 'Kevin Sans', sans-serif; /* font-hand */
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
.alert {
  margin-top: -16rpx; /* -mt-2 */
  text-align: right;
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #c2412d; /* text-red */
}
.line {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  column-gap: 32rpx; /* gap-x-4 */
  row-gap: 8rpx;
}
.line-name {
  display: block;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 32rpx; /* text-base × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.line-meta {
  display: block;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
.line-controls {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.total {
  font-family: 'Kevin Sans', sans-serif; /* font-script */
  font-size: 42rpx; /* text-2xl × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx; /* gap-3 */
}
.row-gap {
  display: flex;
  gap: 16rpx; /* gap-2 */
}
