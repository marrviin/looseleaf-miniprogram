.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 56rpx; /* gap-7 */
  padding: 8rpx 0;
}
.stack--tight {
  gap: 16rpx; /* gap-2 */
  padding: 0;
}
.col-start {
  align-items: flex-start;
}
.col-center {
  align-items: center;
}
.label {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #2a2420;
}
.live {
  font-family: 'Kevin Sans', sans-serif; /* font-hand */
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
.alert {
  margin-top: -16rpx; /* -mt-2 */
  text-align: right;
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #c2412d; /* text-red */
}
.line {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  column-gap: 32rpx; /* gap-x-4 */
  row-gap: 8rpx;
}
.line-name {
  display: block;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 32rpx; /* text-base × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.line-meta {
  display: block;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
.line-controls {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.total {
  font-family: 'Kevin Sans', sans-serif; /* font-script */
  font-size: 42rpx; /* text-2xl × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx; /* gap-3 */
}
.row-gap {
  display: flex;
  gap: 16rpx; /* gap-2 */
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
