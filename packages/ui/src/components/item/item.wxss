/* ll-item — upstream itemCss() + itemVariants. The outline and ruled rules
   are CSS masks over the tiles in --ll-it-m/--ll-it-r (inline from item.js):
   a row of a few hundred costs no svg. EDGE_TH=5; the outline ::before sits
   inset -2.5px, the mask arms stop 2px short of each corner. */
/* @ll-import tokens */
.ll-item {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 26rpx; /* text-[15px] × 0.88 */
}

/* size: default gap-4 p-4 / sm gap-2.5 px-4 py-3 */
.ll-item--default {
  gap: 32rpx;
  padding: 32rpx;
}
.ll-item--sm {
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

/* variant=muted: paper-shade wash, rounded (color-mix 65% precomputed) */
.ll-item--muted {
  background-color: rgba(236, 230, 218, 0.65);
  border-radius: 6px;
}

/* link row: one big hit area (asChild <a>) — swipe while the finger is down */
.ll-item--link {
  cursor: pointer;
}
.ll-item--swiped {
  background-color: var(--ll-hi-select);
  border-radius: 3px 8px 4px 9px / 8px 3px 9px 4px;
}

/* variant=outline: ruled pencil box whose corners meet, z-index -1 behind
   the isolated host */
.ll-item--outline::before {
  content: '';
  position: absolute;
  inset: -2.5px; /* -EDGE_TH/2 */
  z-index: -1;
  pointer-events: none;
  background: var(--ll-pencil);
  opacity: 0.8;
  -webkit-mask-image: var(--ll-it-eh), var(--ll-it-eh), var(--ll-it-ev), var(--ll-it-ev);
  mask-image: var(--ll-it-eh), var(--ll-it-eh), var(--ll-it-ev), var(--ll-it-ev);
  -webkit-mask-size: calc(100% - 4px) 5px, calc(100% - 4px) 5px, 5px calc(100% - 4px), 5px calc(100% - 4px);
  mask-size: calc(100% - 4px) 5px, calc(100% - 4px) 5px, 5px calc(100% - 4px), 5px calc(100% - 4px);
  -webkit-mask-position: 2px 0, 2px 100%, 0 2px, 100% 2px;
  mask-position: 2px 0, 2px 100%, 0 2px, 100% 2px;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
}

/* ruled group: blue pencil line under every row, always matching its height */
.ll-item--ruled::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2.5px;
  height: 5px;
  z-index: -1;
  pointer-events: none;
  background: var(--ll-rule-blue);
  opacity: 0.85;
  -webkit-mask-image: var(--ll-it-r);
  mask-image: var(--ll-it-r);
  /* keep: single-URL var works for repeat-x rule */
  -webkit-mask-size: 96px 5px;
  mask-size: 96px 5px;
  -webkit-mask-repeat: repeat-x;
  mask-repeat: repeat-x;
}