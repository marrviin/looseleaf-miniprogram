.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
/* 01/03: the palette box (upstream w-[22rem]) */
.palette-box {
  width: 352px;
  max-width: 100%;
}
.said-line {
  font-size: 25rpx; /* text-sm ×0.88 */
  color: #8a857c;
  margin: -8rpx 0 24rpx;
}
/* 02: keycap group inside the open button */
.kbd-group {
  display: inline-flex;
  align-items: center;
  gap: 8rpx; /* gap-1 */
}
/* 03: the idle hint (upstream px-3 py-6 text-center font-script text-xl) */
.idle-hint {
  padding: 48rpx 24rpx; /* py-6 px-3 */
  text-align: center;
  font-family: 'Kevin Sans', sans-serif; /* font-script */
  font-size: 35rpx; /* text-xl 20px ×0.88 */
  line-height: 1.25;
  color: #4a433c; /* text-ink-muted */
}
/* 04: the status picker row */
.status-row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.status-label {
  font-family: 'Kevin Sans', sans-serif; /* font-hand */
  font-size: 25rpx; /* text-sm ×0.88 */
  color: #4a433c; /* text-ink-muted */
}
.status-tick {
  margin-left: auto; /* ms-auto */
  color: #2c4f9e; /* text-ink-you */
}
