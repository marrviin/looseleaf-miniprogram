/* ll-signature */
/* @ll-import tokens */
.ll-signature {
  position: relative;
  isolation: isolate;
  display: inline-block;
  align-self: flex-start;
  justify-self: start;
  padding-bottom: 12px;
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  line-height: 1;
  white-space: nowrap;
  color: var(--ll-ink-you, #2c4f9e);
}
.ll-signature.is-tone-ink {
  color: var(--ll-ink, #2a2420);
}
.ll-signature.is-sm {
  font-size: 28px;
}
.ll-signature.is-md {
  font-size: 44px;
}
.ll-signature.is-lg {
  font-size: 64px;
}
.ll-signature__name {
  position: relative;
  z-index: 1;
}
.ll-signature__ink {
  position: absolute;
  z-index: 0;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
/* The signing replay: both strokes draw left→right (upstream wipes the
   name with an inset clip-path, then reveals the flourish). */
@keyframes ll-sig-wipe {
  from {
    -webkit-clip-path: inset(-10% 100% -10% -4%);
    clip-path: inset(-10% 100% -10% -4%);
  }
  to {
    -webkit-clip-path: inset(-10% 0% -10% -4%);
    clip-path: inset(-10% 0% -10% -4%);
  }
}
