.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack-12 { display: flex; flex-direction: column; gap: 12px; }
.group-block { margin-bottom: 24rpx; }
.kicker {
  font-size: 22rpx;
  color: #8a857c;
  margin-bottom: 8rpx;
}
.row-baseline {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 40rpx;
  row-gap: 12rpx;
}
.letter-line {
  font-size: 15px;
  line-height: 28px;
}
.sig-slot {
  min-height: 72px;
  padding-top: 15px;
}
