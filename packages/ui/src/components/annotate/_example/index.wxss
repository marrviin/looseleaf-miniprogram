.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  max-width: 768rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* upstream: flex flex-wrap items-center gap-4 */
.toggles {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}
/* upstream font-type text-[11px] text-pencil-text */
.notes-meta {
  font-size: 22rpx;
  color: var(--ll-pencil-text, #5a554e);
}
/* upstream font-script text-[2.1rem] font-bold */
.notes-title {
  font-family: var(--font-script, cursive);
  font-size: 60rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 8rpx 0 20rpx;
}
/* upstream text-[17px] leading-[28px] */
.notes-body {
  font-size: 30rpx;
  line-height: 2;
  color: #2a2420;
}
/* upstream text-sm text-pencil-text */
.notes-foot {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: var(--ll-pencil-text, #5a554e);
}
/* upstream: grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4 — one column
   pair fits the miniprogram screen */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 48rpx;
  row-gap: 48rpx;
  margin-bottom: 24rpx;
}
/* upstream: grid gap-1.5 */
.type-cell {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 30rpx;
  color: #2a2420;
}
.type-name {
  font-size: 22rpx;
  color: var(--ll-pencil-text, #5a554e);
}
