.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack-8 { display: flex; flex-direction: column; gap: 8px; }
.para {
  font-size: 17px;
  line-height: 1.7;
}
.note-script {
  font-family: 'Kevin Sans Script', 'Kevin Sans', 'Bradley Hand', cursive;
  font-size: 26px;
  line-height: 1.15;
}
