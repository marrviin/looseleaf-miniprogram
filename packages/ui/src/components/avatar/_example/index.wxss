.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* rows: gap-6 (24px) items-end for the preview; gap-4 wrap for the colours;
   gap-5 for the ring row */
.row {
  display: flex;
  align-items: center;
  gap: 32rpx; /* gap-4 */
}
.row--items-end {
  align-items: flex-end;
  gap: 48rpx; /* gap-6 */
  flex-wrap: wrap;
}
.row--wrap {
  flex-wrap: wrap;
}
.row--gap5 {
  gap: 40rpx; /* gap-5 */
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 48rpx; /* gap-6 */
  padding: 8rpx 0;
}
.note {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}

/* team card */
.card-stage {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}
.team-row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.team-row--pt {
  padding-top: 8rpx; /* pt-1... pt-2? upstream pt-1 = 4px = 8rpx */
}
.team-id {
  display: flex;
  flex-direction: column;
  justify-content: center;
  line-height: 1.25; /* leading-tight */
}
.team-name {
  font-weight: 700;
  font-size: 28rpx;
  color: #2a2420;
}
.team-role {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
