.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* gap-4 */
  padding: 8rpx 0;
}
.stack--tight {
  gap: 12rpx; /* gap-1.5 */
  padding: 0;
}
.form-md {
  max-width: 896rpx; /* max-w-md */
  width: 100%;
}
.form-sm {
  max-width: 608rpx; /* max-w-sm */
  width: 100%;
}
.row-baseline {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx; /* gap-3 */
}
.row-gap {
  display: flex;
  gap: 24rpx; /* gap-3 */
}
.file-name {
  display: flex;
  align-items: center;
  gap: 12rpx; /* gap-1.5 */
}
.file-label {
  font-size: 26rpx; /* text-[15px] × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.file-meta {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
.out-xl {
  font-family: 'Kevin Sans', sans-serif; /* font-script */
  font-size: 42rpx; /* text-2xl × 0.88 */
  line-height: 1;
  color: #2a2420;
}
.demo-box {
  padding: 8rpx 0 24rpx;
}
