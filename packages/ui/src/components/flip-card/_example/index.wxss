.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.fc-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.fc-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.fc-word {
  display: block;
  font-size: 36px;
  color: #2a2420;
}
.fc-word-sm {
  font-size: 30px;
}
.fc-note {
  display: block;
  font-size: 24rpx;
  color: #8a857c;
}
.fc-recipe {
  display: block;
  font-size: 30rpx;
  color: #2a2420;
}
.fc-count {
  font-size: 24rpx;
  color: #8a857c;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}
