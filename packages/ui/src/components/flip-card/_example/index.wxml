<!-- ll-flip-card demo — mirrors the upstream docs page
     (#/components/flip-card). The upstream compound parts fold into one
     component: faces are the named slots front/back; 04's own trigger
     button calls toggle() on the component. -->
<view class="demo">
  <ll-page-title underline="highlight" seed="flip-card" custom-style="margin-bottom:16rpx;">Flip card</ll-page-title>
  <view class="sec-desc">A card that turns over — click it, or Tab to it and press Space. The card lifts off the desk as it turns.</view>

  <view class="sec sec--desk">
    <view class="sub-h3">Default</view>
    <view class="sec-desc">An index card in front, a slip behind.</view>
    <view class="fc-center">
      <ll-flip-card id="fc-main" label="Show the answer">
        <view slot="front">
          <text class="fc-word">le chat</text>
          <text class="fc-note">(masculine noun)</text>
        </view>
        <view slot="back">
          <text class="fc-word">the cat</text>
          <text class="fc-note">purrs, ignores you</text>
        </view>
      </ll-flip-card>
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sub-h3">Notepad flip</view>
    <view class="sec-desc">axis="x" turns it like a page of a top-bound pad. Any paper works for either face.</view>
    <view class="fc-center">
      <ll-flip-card axis="x" label="Turn the page" front-stock="sticky-yellow" back-stock="index-card" custom-style="width:256px;height:208px">
        <view slot="front">
          <text class="fc-word fc-word-sm">pancakes</text>
          <text class="fc-note">turn me over for the recipe</text>
        </view>
        <view slot="back">
          <text class="fc-recipe">2 eggs, 200 g flour,</text>
          <text class="fc-recipe">300 ml milk. Whisk, rest,</text>
          <text class="fc-recipe">fry until it smells right.</text>
        </view>
      </ll-flip-card>
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sub-h3">Vocabulary deck</view>
    <view class="sec-desc">A real use: a controlled flip card as a study deck. Turning is the answer; Next shows the front of the following card.</view>
    <view class="fc-center">
      <ll-flip-card id="fc-deck" flipped="{{flipped}}" bind:flippedchange="onFlipped" label="{{flipped ? 'Show the word' : 'Show the answer'}}">
        <view slot="front">
          <text class="fc-word">{{deckWord}}</text>
        </view>
        <view slot="back">
          <text class="fc-word">{{deckMeaning}}</text>
        </view>
      </ll-flip-card>
      <view class="fc-row">
        <ll-button variant="outline" size="sm" bind:tap="deckBack">Back</ll-button>
        <text class="fc-count">{{deckIndex + 1}} of {{deck.length}}</text>
        <ll-button size="sm" bind:tap="deckNext">Next</ll-button>
      </view>
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sub-h3">Buttons on the faces</view>
    <view class="sec-desc">trigger={{false}} leaves the card free of the overlay, so a face can hold real buttons. The flip button is your own.</view>
    <view class="fc-center">
      <ll-flip-card id="fc-pass" trigger="{{false}}" label="Flip the pass" custom-style="width:288px;height:208px">
        <view slot="front">
          <text class="fc-word fc-word-sm">Studio pass</text>
          <ll-button size="sm" bind:tap="bookDesk">Book a desk</ll-button>
        </view>
        <view slot="back">
          <text class="fc-recipe">Mon to Fri, 9 to 5</text>
          <text class="fc-note">bring your own kettle</text>
        </view>
      </ll-flip-card>
      <view class="fc-row">
        <ll-button variant="link" size="sm" bind:tap="flipPass">Details</ll-button>
      </view>
    </view>
  </view>

  <view class="sr-only" aria-live="polite">{{said}}</view>
</view>
