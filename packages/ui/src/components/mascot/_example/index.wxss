.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 40rpx;
}
.row--wrap {
  flex-wrap: wrap;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 8rpx 0;
}

.fig {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.fig-cap {
  font-size: 25rpx;
  color: #8a857c;
}
.more-btn {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #2a2420;
  text-decoration: underline;
}

.empty-row {
  display: flex;
  align-items: center;
  gap: 40rpx; /* gap-5 */
}
.empty-title {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 42rpx; /* text-2xl x0.88 */
  color: #2a2420;
}
.empty-body {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a857c;
}
