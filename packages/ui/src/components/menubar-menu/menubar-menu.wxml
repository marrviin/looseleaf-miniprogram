<!-- ll-menubar-menu — a title on the bar and its slip. Rows bubble `select`
     to close, `change` to stay open; the title wears the highlighter while
     open (hover: hover-class, the touch stand-in for Radix's hover). -->
<view class="ll-menubar-menu">
  <view
    class="ll-menubar-menu__trigger {{open ? 'll-menubar-menu__trigger--hi' : ''}} {{disabled ? 'll-menubar-menu__trigger--disabled' : ''}}"
    hover-class="{{disabled ? '' : 'll-menubar-menu__trigger--hi'}}"
    hover-start-time="0"
    hover-stay-time="80"
    catchtap="onTriggerTap"
    aria-role="menuitem"
    aria-haspopup="menu"
    aria-expanded="{{open}}"
    aria-label="{{ariaLabel}}"
  >
    <text>{{label}}</text>
  </view>

  <block wx:if="{{visible}}">
    <view class="ll-menubar-menu__catcher" catch:touchmove="noop" catch:tap="onOutsideTap" />
    <view
      class="ll-menubar-menu__panel {{closing ? 'll-menubar-menu__panel--closing' : ''}} {{placed ? '' : 'is-placing'}}"
      style="{{panelStyle}}{{customStyle}}"
      catch:tap="noop"
      bind:select="onItemSelect"
      aria-role="menu"
      aria-label="{{label}}"
    >
      <ll-paper
        stock="{{stock}}"
        edge="{{edge}}"
        tilt="{{tilt}}"
        tape="{{tape}}"
        rules="none"
        seed="{{seed}}"
        shadow-css="{{liftShadow}}"
        custom-style="position:relative;display:block;width:100%;box-sizing:border-box;"
      >
        <view class="ll-menubar-menu__viewport" style="{{viewportStyle}}">
          <view class="ll-menubar-menu__content">
            <slot />
          </view>
        </view>
      </ll-paper>
    </view>
  </block>
</view>
