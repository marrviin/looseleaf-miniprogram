/* ll-accordion-content */
/* @ll-import tokens */
.ll-accordion-content {
  font-size: 24rpx; /* text-sm x .88 */
}
/* upstream: outer div pt-0 pb-4 */
.ll-accordion-content__outer {
  padding-top: 0;
  padding-bottom: 32rpx;
}
.ll-accordion-content__inner {
  position: relative;
}
/* bracket && ps-5 */
.ll-accordion-content__inner--bracketed {
  padding-left: 40rpx;
}
/* pointer-events-none absolute inset-y-0 start-0 w-3.5 (14px) */
.ll-accordion-content__bracket {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 28rpx;
  pointer-events: none;
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
