.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx; /* gap-4 */
  margin-bottom: 24rpx;
}
.center-row.wrap {
  flex-wrap: wrap;
}

/* 01-move-goal: mx-auto w-full max-w-sm */
.goal-wrap {
  margin: 0 auto;
  width: 100%;
  max-width: 384px;
}
.goal-body {
  padding: 32rpx;
  padding-bottom: 0;
}
.goal-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.goal-mid {
  text-align: center;
}
/* font-script text-7xl = 72px x .75 x 2 = 108rpx */
.goal-num {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 108rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.goal-unit {
  font-size: 20rpx; /* 0.7rem x .88 x 2 */
  color: #8a857c;
}
/* mt-4 h-16 items-end justify-center gap-1; hatched pencil-mark bars */
.goal-bars {
  margin-top: 32rpx;
  height: 128rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
}
.goal-bar {
  width: 20rpx; /* w-2.5 */
  border-left: 1px solid rgba(58, 44, 30, 0.45);
  border-right: 1px solid rgba(58, 44, 30, 0.45);
  border-top: 1px solid rgba(58, 44, 30, 0.45);
  background: repeating-linear-gradient(-58deg, rgba(58, 44, 30, 0.45) 0 1.2px, transparent 1.2px 3.6px);
}

/* 02-snap-points: min-h-0 flex-col; the list scrolls at the top snap */
.snaps-wrap {
  display: flex;
  flex-direction: column;
  min-height: 0;
  flex: 1;
  margin: 0 auto;
  width: 100%;
  max-width: 384px;
}
.snaps-list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 32rpx 32rpx;
}
.snaps-item {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1px dashed rgba(58, 44, 30, 0.3); /* border-pencil-mark/50 */
  font-size: 28rpx;
}
.snaps-n {
  width: 40rpx;
  text-align: right;
  font-size: 25rpx;
  color: #8a857c;
}

/* 04: profile form */
.rd-form {
  display: grid;
  align-items: start;
  gap: 32rpx;
  padding: 0 32rpx 32rpx;
}
.rd-field {
  display: grid;
  gap: 16rpx;
}
