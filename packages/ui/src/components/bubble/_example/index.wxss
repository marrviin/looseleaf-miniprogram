/* ll-bubble demo */
/* @ll-import tokens */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.bb-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 4px 0 16px;
}
.bb-col.is-end {
  align-items: flex-end;
}
.bb-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  padding: 4px 0 16px;
}
.bb-grid .bb-cell { width: 330rpx; }
.row { min-height: 32px; }
.said { font-size: 24rpx; color: #8a857c; }
.w { font-weight: 400; }
