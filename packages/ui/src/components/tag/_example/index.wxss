.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
/* upstream stages tags on the desk, centered */
.center-stage {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: center;
  column-gap: 96rpx; /* gap-x-12 */
  row-gap: 128rpx; /* gap-y-16 */
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.luggage-inner {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.shelf-card {
  max-width: 720rpx;
  margin: 0 auto 24rpx;
}
