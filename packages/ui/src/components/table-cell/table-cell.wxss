/* ll-table-cell — <td>: px-3 py-2, middle, nowrap. The rule view:
   wrapper carries the geometry + edge fade, the inner tile view the
   repeat-x pull (nesting = upstream's mask-composite intersect). Tile and
   geometry vars are inherited from the row's inline style. */
/* @ll-import tokens */
.ll-table-cell {
  position: relative;
  display: table-cell;
  padding: 16rpx 24rpx; /* py-2 px-3 */
  vertical-align: middle;
  white-space: nowrap;
}

/* the hanging rule (shared structure with ll-table-head) */
.ll-cell-rule {
  position: absolute;
  left: 0;
  right: 0;
  bottom: var(--ll-rule-b, -4px);
  height: var(--ll-tbl-h, 8px);
  pointer-events: none;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
}
.ll-cell-rule--top {
  bottom: auto;
  top: var(--ll-rule-b, -6px);
  transform: scaleY(-1);
}
.ll-cell-rule--fs {
  -webkit-mask-image: var(--ll-fade-s);
  mask-image: var(--ll-fade-s);
}
.ll-cell-rule--fe {
  -webkit-mask-image: var(--ll-fade-e);
  mask-image: var(--ll-fade-e);
}
.ll-cell-rule--fse {
  -webkit-mask-image: var(--ll-fade-se);
  mask-image: var(--ll-fade-se);
}
.ll-cell-rule--hide {
  display: none;
}
.ll-cell-rule__tile {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: var(--ll-rule-color, var(--ll-pencil-mark));
  -webkit-mask-image: var(--ll-tbl-img);
  mask-image: var(--ll-tbl-img);
  -webkit-mask-size: 960px var(--ll-tbl-h);
  mask-size: 960px var(--ll-tbl-h);
  -webkit-mask-repeat: repeat-x;
  mask-repeat: repeat-x;
  -webkit-mask-position: calc(var(--ll-rx, 0px) + var(--ll-cx, 0px)) 0;
  mask-position: calc(var(--ll-rx, 0px) + var(--ll-cx, 0px)) 0;
}
