/* ll-command-input — relative isolate flex h-12 items-center gap-2 px-3. */
.ll-command-input__wrapper {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  gap: 16rpx; /* gap-2 */
  height: 96rpx; /* h-12 */
  box-sizing: border-box;
  padding: 0 24rpx; /* px-3 */
  flex-shrink: 0;
}
.ll-command-input__control {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-family: 'Kevin Sans', sans-serif; /* font-hand */
  font-size: 28rpx; /* text-base x .88 */
  color: #2a2420;
  caret-color: #2a2420;
}
.ll-command-input__control--disabled {
  color: #5a554e; /* disabled:text-pencil-text */
}
.ll-command-input__placeholder {
  color: #5a554e; /* placeholder:text-(--ll-placeholder) */
}
/* The polite status — screen-reader-only upstream; kept out of sight. */
.ll-command-input__status {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
