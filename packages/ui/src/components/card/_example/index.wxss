.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
/* upstream examples wrap cards in a centered max-w column */
.stack-card {
  max-width: 640rpx;
  margin: 0 auto 24rpx;
}
/* Settings card rows: flex items-center justify-between gap-4, grid gap-3 */
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
.set-row:last-child {
  margin-bottom: 0;
}
.set-label {
  font-size: 25rpx;
  color: #2a2420;
}
.stat-trend {
  font-size: 25rpx;
}

/* login / create project forms */
.field {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* gap-2 */
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.label {
  font-size: 25rpx; /* text-sm × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.link {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--ll-link, #2c4f9e);
  text-decoration: underline;
  text-underline-offset: 8rpx;
}
.status {
  margin-top: 16rpx; /* mt-4 */
  min-height: 48rpx; /* min-h-6 */
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}
/* ll-select lands later */
.select-placeholder {
  border: 1px solid rgba(58, 44, 30, 0.25);
  border-radius: 4rpx;
  padding: 16rpx 24rpx;
  font-size: 25rpx;
  color: #8a857c;
}
