.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
/* upstream examples wrap cards in a centered max-w column */
.stack-card {
  max-width: 640rpx;
  margin: 0 auto 24rpx;
}
/* Settings card rows: flex items-center justify-between gap-4, grid gap-3 */
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
.set-row:last-child {
  margin-bottom: 0;
}
.set-label {
  font-size: 25rpx;
  color: #2a2420;
}
.stat-trend {
  font-size: 25rpx;
}

/* login / create project forms */
.field {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* gap-2 */
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.label {
  font-size: 25rpx; /* text-sm × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.link {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--ll-link, #2c4f9e);
  text-decoration: underline;
  text-underline-offset: 8rpx;
}
.status {
  margin-top: 16rpx; /* mt-4 */
  min-height: 48rpx; /* min-h-6 */
  font-size: 25rpx; /* text-sm × 0.88 */
  color: var(--muted-foreground, #4a433c);
}

/* guest book: max-w-sm (384px) column, "No. 0042" in muted small text */
.stack-sm {
  max-width: 768rpx;
  margin: 0 auto 24rpx;
}
.gb-no {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #8a857c;
}

/* article card: centered column, sized so tape="both" overhang (-28px a
   side) stays inside the stage padding (upstream's max-w-md sits in a
   desktop-width stage, so its overhang also lands in the padding) */
.stack-md {
  max-width: 588rpx;
  margin: 0 auto 24rpx;
}
.article-p {
  font-size: 26rpx; /* text-[15px] × 0.88 */
  line-height: 1.625; /* leading-relaxed */
}

/* on every stock: grid gap-7 p-2, two columns like the docs page (sm+) */
.stocks-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 56rpx; /* gap-7 */
  padding: 16rpx; /* p-2 */
}
.stock-note {
  font-size: 25rpx; /* text-sm × 0.88 */
}

/* pinned, clipped, stapled: grid gap-x-9 gap-y-14 p-6 pt-12 */
.fastener-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  column-gap: 72rpx; /* gap-x-9 */
  row-gap: 112rpx; /* gap-y-14 */
  padding: 96rpx 48rpx 48rpx; /* pt-12 p-6 */
}



/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
