/* ll-card — upstream Card adds only layout on top of Paper: flex-col gap-6
   py-6 with text-card-foreground. The sheet (colors, textures, shadows,
   edges, tape, fasteners) is ll-paper's absolute underlay. */
/* @ll-import tokens */
.ll-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 48rpx; /* upstream gap-6 (24px) */
  padding: 48rpx 0; /* py-6 */
  box-sizing: border-box;
  color: var(--ll-ink); /* text-card-foreground */
  font-family: 'Kevin Sans', sans-serif;
}
