/* @ll-import tokens */
.ll-slider {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 48rpx; /* min-h-6 */
  user-select: none;
}
.ll-slider--vertical {
  flex-direction: column;
  width: auto;
  min-width: 48rpx; /* min-w-6 */
  height: 100%;
  min-height: 352rpx; /* min-h-44 */
}
.ll-slider__track {
  position: relative;
  isolation: isolate;
  flex-grow: 1;
  width: 100%;
  height: 16rpx; /* h-2 */
  background: #e9e4d8; /* bg-paper-shade — hidden once ink lands */
}
.ll-slider--vertical .ll-slider__track {
  width: 16rpx; /* w-2 */
  height: 100%;
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
.ll-slider__range {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.ll-slider__thumb {
  position: absolute;
  width: 40rpx; /* size-5 */
  height: 40rpx;
  z-index: 1;
  pointer-events: none;
  /* upstream after:-inset-1.5 — the touch target is larger than the drawing */
}
.ll-slider__thumb::after {
  content: '';
  position: absolute;
  inset: -12rpx;
}
