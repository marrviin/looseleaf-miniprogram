.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx; /* gap-4 */
  margin-bottom: 24rpx;
}
.center-row.wrap {
  flex-wrap: wrap;
}
/* 03-undo: max-w-xs list, dashed pencil separators */
.notes {
  display: flex;
  flex-direction: column;
  gap: 8rpx; /* gap-2 */
  max-width: 480rpx; /* max-w-xs */
  margin-bottom: 16rpx;
}
.note-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx; /* gap-2 */
  padding: 8rpx 0; /* py-1 */
  border-bottom: 1rpx dashed rgba(58, 44, 30, 0.45); /* border-pencil-mark/60 */
}
.note-text {
  font-size: 28rpx;
}
.notes-empty {
  margin-top: 8rpx;
}
