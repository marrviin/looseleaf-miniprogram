.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.sentence {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #2a2420;
  line-height: 1.8;
  font-family: 'Kevin Sans', sans-serif;
  margin-bottom: 24rpx;
}
.kbd-rows {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 64rpx; /* gap-x-8 */
  row-gap: 24rpx; /* gap-y-3 */
}
.kbd-group {
  display: inline-flex;
  align-items: center;
  gap: 8rpx; /* gap-1 */
}
.plus {
  font-size: 25rpx; /* text-sm */
  color: #8a857c;
}
.press-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx; /* gap-2 */
}
.press-key {
  display: inline-flex;
}
.hint {
  font-size: 25rpx; /* text-sm */
  color: #8a857c;
  margin-top: 24rpx;
}
.sheet {
  max-width: 672rpx; /* max-w-md */
  margin: 0 auto;
}
.search-pos {
  position: relative;
  display: flex;
  align-items: center;
}
.search-pos--wide {
  width: 576rpx; /* max-w-xs */
  max-width: 100%;
}
.search-kbd {
  position: absolute;
  right: 24rpx; /* end-3 */
  top: 50%;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  pointer-events: none;
}
.sheet-list {
  display: flex;
  flex-direction: column;
}
.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx; /* gap-4 */
}
.sheet-what {
  font-size: 26rpx; /* 15px x .88 */
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.center-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx; /* gap-4 */
  padding: 16rpx 0 24rpx;
}
.center-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 32rpx;
  padding: 16rpx 0 24rpx;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
