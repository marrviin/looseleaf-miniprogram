/* ll-corkboard demo */
/* @ll-import tokens */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.board-wrap {
  margin-top: 16rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 40rpx;
  margin-top: 16rpx;
}
.layout-json {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #8a857c;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bold { font-weight: 700; }
