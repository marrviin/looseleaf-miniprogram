<!-- ll-corkboard demo — mirrors the upstream docs page (#/components/corkboard):
     intro, then the Examples entries with the page's own copy.
     Installation/Usage/API reference/Accessibility/Related are
     intentionally omitted. -->
<view class="demo">
  <ll-page-title underline="highlight" seed="corkboard" custom-style="margin-bottom:16rpx;">Corkboard</ll-page-title>
  <view class="sec-desc">A wooden-framed corkboard with notes you can pick up. Drag them with a pointer, or focus one and use the arrow keys to move it and R to turn it. Positions are plain JSON you can store and restore.</view>

  <view class="sec sec--desk">
    <view class="sec-h2">Examples</view>

    <view class="sub-h3">Default</view>
    <view class="sec-desc">Pick a note up and move it. Or focus one, then use the arrow keys, R to turn it, Enter to bring it to the front.</view>
    <view class="board-wrap">
      <ll-corkboard id="board" custom-style="height:360px;">
        <ll-corkboard-note note-id="mum" id="note-mum" x="{{20}}" y="{{26}}">Call mum about Sunday</ll-corkboard-note>
        <ll-corkboard-note note-id="ink" id="note-ink" x="{{112}}" y="{{64}}" stock="sticky-pink" rotate="{{2.5}}">Buy more ink!! (the blue felt)</ll-corkboard-note>
        <ll-corkboard-note note-id="tape" id="note-tape" x="{{80}}" y="{{190}}" stock="sticky-green" pinned="{{false}}" rotate="{{-2}}">Tape it up before Friday</ll-corkboard-note>
      </ll-corkboard>
    </view>

    <view class="sub-h3">Any paper</view>
    <view class="sec-desc">A note is a Paper: sticky notes, an index card with a list, a kraft tag, a photo. With bare, any paper object of the library can be the note. Same drag, same keys.</view>
    <view class="board-wrap">
      <ll-corkboard custom-style="height:440px;" label="Ideas">
        <ll-corkboard-note note-id="list" id="note-list" x="{{12}}" y="{{24}}" stock="index-card" pin-color="grass" label="Ideas list" custom-style="width:224px;">
          <view class="bold">ideas</view>
          <view>1. a thing that boils</view>
          <view>2. a thing that tears</view>
        </ll-corkboard-note>
        <ll-corkboard-note note-id="tag" id="note-tag" x="{{112}}" y="{{64}}" stock="kraft" rotate="{{-4}}" pin-color="tomato" custom-style="width:160px;">fragile, hand-drawn</ll-corkboard-note>
        <ll-corkboard-note note-id="photo" id="note-photo" x="{{12}}" y="{{240}}" stock="photo" rotate="{{3}}" pin-color="sky" custom-style="width:176px;">summer, 1987</ll-corkboard-note>
        <ll-corkboard-note note-id="sticky" id="note-sticky" x="{{112}}" y="{{224}}" bare rotate="{{1.5}}" pin-color="grape" label="Sticky note">
          <ll-sticky-note color="orange" tilt="{{false}}" custom-style="width:160px;padding:16px;font-size:20px;">pick me up: a real StickyNote</ll-sticky-note>
        </ll-corkboard-note>
      </ll-corkboard>
    </view>

    <view class="sub-h3">Saved layout</view>
    <view class="sec-desc">Controlled positions: the board is a JSON value, so a layout can be saved, shared and restored. Move things, then reset.</view>
    <view class="board-wrap">
      <ll-corkboard id="board-saved" value="{{layout}}" bind:change="onLayout" label="Sprint board" custom-style="height:340px;">
        <ll-corkboard-note wx:for="{{tasks}}" wx:key="id" note-id="{{item.id}}" x="{{item.x}}" y="{{item.y}}" stock="{{item.stock}}">{{item.text}}</ll-corkboard-note>
      </ll-corkboard>
      <view class="row">
        <ll-button size="sm" variant="outline" bind:tap="resetLayout">Reset layout</ll-button>
        <view class="layout-json">{{layoutText}}</view>
      </view>
    </view>
  </view>
</view>
