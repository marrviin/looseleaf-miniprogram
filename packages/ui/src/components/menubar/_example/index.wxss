.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
/* 02: bar + acting sheet */
.editor-col {
  display: grid;
  gap: 32rpx; /* gap-4 */
  margin-bottom: 24rpx;
}
.editor-text {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 32rpx; /* text-lg ×0.88 */
  line-height: 1.5;
  color: #2a2420;
}
.editor-text.is-bold {
  font-weight: 700;
}
.editor-text.is-italic {
  font-style: italic;
}
/* 03: the composed app header */
.header-row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
}
.header-title {
  display: flex;
  align-items: center;
  gap: 16rpx; /* gap-2 */
  font-family: 'Kevin Sans', sans-serif;
  font-size: 44rpx; /* text-2xl ×0.88 */
  font-weight: 600;
  line-height: 1.1;
  color: #2a2420;
  white-space: nowrap;
}
.header-note {
  margin-top: 12rpx;
  font-size: 25rpx; /* text-sm ×0.88 */
  color: #8a857c;
}
