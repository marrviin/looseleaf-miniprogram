<!-- ll-index-card demo — mirrors the upstream docs page
     (#/components/index-card). -->
<view class="demo">
  <ll-page-title underline="highlight" seed="index-card" custom-style="margin-bottom:16rpx;">Index card</ll-page-title>
  <view class="sec-desc">A 3 x 5 card of cream stock with a red header rule and blue lines every 30 px. Header, body and footer parts lay out on the printed rules; the card can have its rod hole punched at the foot, a colored flag stuck over its edge, and a pile of cards behind it.</view>

  <view class="sec sec--desk">
    <view class="sec-h2">Preview</view>
    <view class="sub-h3">An index card</view>
    <view class="sec-desc">A red header rule, blue lines every 30 px, and text that sits on them. The title goes above the red line; the footer at the foot.</view>
    <view class="stack">
      <ll-index-card seed="recipes">
        <ll-index-card-header>
          <ll-index-card-title>Recipes</ll-index-card-title>
        </ll-index-card-header>
        <ll-index-card-content>
          <view>oat porridge, the slow way</view>
          <view>soup that forgives</view>
          <view>toast, honestly</view>
        </ll-index-card-content>
        <ll-index-card-footer>
          <view>no. 0042</view>
          <view>p. 3</view>
        </ll-index-card-footer>
      </ll-index-card>
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sec-h2">Examples</view>

    <view class="sub-h3">Rod hole, flag, pile</view>
    <view class="sec-desc">The details of a card that lived in a card box: a hole punched for the rod, a flag stuck over the edge, more cards behind it.</view>
    <view class="stack">
      <ll-index-card hole flag="tomato" stack="{{3}}" seed="sources">
        <ll-index-card-header>
          <ll-index-card-title>Sources</ll-index-card-title>
        </ll-index-card-header>
        <ll-index-card-content>
          <view>sketchbook, dip pen, ink</view>
          <view>sage green, ochre, madder</view>
        </ll-index-card-content>
      </ll-index-card>
      <ll-index-card hole flag="sky" seed="words" custom-style="min-height:388rpx;">
        <ll-index-card-header>
          <ll-index-card-title>Words</ll-index-card-title>
        </ll-index-card-header>
        <ll-index-card-content>
          <view>petrichor</view>
          <view>the smell of rain on dry earth</view>
        </ll-index-card-content>
      </ll-index-card>
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sub-h3">Taped, clipped, stacked</view>
    <view class="sec-desc">Paper's tape and fasteners work on a card as on any sheet. Cards turn under a quarter of a degree, so the printed lines stay level under the text.</view>
    <view class="stack">
      <ll-index-card tape="both" tape-kind="washi-dots" stack="{{1}}" seed="washi" custom-style="min-height:388rpx;">
        <ll-index-card-header>
          <ll-index-card-title>Taped up</ll-index-card-title>
        </ll-index-card-header>
        <ll-index-card-content>
          <view>two strips of washi</view>
        </ll-index-card-content>
      </ll-index-card>
      <ll-index-card fastener="clip" seed="clip" custom-style="min-height:388rpx;">
        <ll-index-card-header>
          <ll-index-card-title>Clipped</ll-index-card-title>
        </ll-index-card-header>
        <ll-index-card-content>
          <view>a paper clip, top right</view>
        </ll-index-card-content>
        <ll-index-card-footer>
          <view>page 1 of 1</view>
        </ll-index-card-footer>
      </ll-index-card>
    </view>
  </view>

  <view class="sec sec--desk">
    <view class="sub-h3">Flashcards</view>
    <view class="sec-desc">A real use: a pile of flashcards. Press a button to flip the top card between the question and the answer; the pile behind it shows how many are left.</view>
    <view class="stack stack--center">
      <ll-index-card hole flag="{{shown ? 'grass' : false}}" stack="{{leftStack}}" seed="card-{{i}}" custom-style="min-height:508rpx;">
        <ll-index-card-header>
          <ll-index-card-title>{{cards[i].q}}</ll-index-card-title>
        </ll-index-card-header>
        <ll-index-card-content>
          <view wx:if="{{shown}}">{{cards[i].a}}</view>
          <view wx:else custom-style="color:#4a433c;">what does it mean?</view>
        </ll-index-card-content>
        <ll-index-card-footer>
          <view>{{i + 1}} of {{cards.length}}</view>
        </ll-index-card-footer>
      </ll-index-card>
      <view class="row">
        <ll-button variant="secondary" size="sm" bind:tap="flip">{{shown ? 'Hide' : 'Show the answer'}}</ll-button>
        <ll-button size="sm" disabled="{{i === cards.length - 1}}" bind:tap="next">Next card</ll-button>
      </view>
    </view>
  </view>
</view>
