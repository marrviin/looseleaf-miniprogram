.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack-12 {
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* gap-3 */
  padding: 16rpx 0;
}
.said-line {
  font-size: 25rpx;
  color: #4a433c;
}
.said-line--bad {
  color: #c2412d;
}
/* 03 — the two-column country/region row (max-sm folds to one) */
.form-grid {
  display: flex;
  gap: 32rpx;
  flex-wrap: wrap;
}
.form-col {
  flex: 1;
  min-width: 280rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.form-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
