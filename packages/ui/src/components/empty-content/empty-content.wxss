/* ll-empty-content — flex w-full max-w-sm min-w-0 flex-col items-center
   gap-4 text-sm text-balance. */
/* @ll-import tokens */
.ll-empty-content {
  display: flex;
  width: 100%;
  max-width: 768rpx; /* max-w-sm = 24rem */
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 32rpx; /* gap-4 */
  font-family: 'Kevin Sans', sans-serif;
  font-size: 25rpx; /* text-sm x size-adjust .88 */
  text-align: center;
}
