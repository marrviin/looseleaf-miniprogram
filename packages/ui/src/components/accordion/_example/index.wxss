.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.max-w-md { max-width: 672rpx; }
.row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.field { display: grid; gap: 8rpx; margin-bottom: 16rpx; }
.field-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.foot-note { font-size: 24rpx; color: #8a857c; }
.para { margin-bottom: 16rpx; line-height: 1.5; color: #2a2420; }
