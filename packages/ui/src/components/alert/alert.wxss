/* ll-alert — ink box behind, icon mark at the left of the title row */
/* @ll-import tokens */
.ll-alert {
  position: relative;
  isolation: isolate;
  width: 100%;
  color: var(--ll-card-foreground, #2a2420);
}
.ll-alert__grid {
  position: relative;
  display: grid;
  grid-template-columns: 28px 1fr;
  column-gap: 12px;
  row-gap: 2px;
  align-items: start;
  padding: 12px 16px;
  font-size: 14px;
}
/* no title row: the description spans both columns */
.ll-alert__grid.is-note {
  display: block;
  padding: 16px 20px;
  font-size: 14px;
  color: var(--ll-ink, #2a2420);
}
.ll-alert.is-note {
  color: var(--ll-ink, #2a2420);
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
.ll-alert.is-destructive {
  color: var(--ll-red, #c2412d);
}
.ll-alert.is-info {
  color: var(--ll-card-foreground, #2a2420);
}
.ll-alert.is-success {
  color: var(--ll-card-foreground, #2a2420);
}
.ll-alert.is-warning {
  color: var(--ll-card-foreground, #2a2420);
}
