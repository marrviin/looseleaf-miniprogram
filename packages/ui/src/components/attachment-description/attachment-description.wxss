/* ll-attachment-description */
/* @ll-import tokens */
.ll-attachment-description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  margin-top: 2px;
  font-size: 14px;
  color: var(--ll-ink-muted);
}
.ll-attachment-description.is-error {
  color: var(--ll-red);
}
