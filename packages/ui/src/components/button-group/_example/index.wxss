.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; padding: 32rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center { display: flex; justify-content: center; }
/* rows wider than the stage pan horizontally instead of clipping
   (upstream is desktop-width; the Sizes rows and mail toolbar overflow) */
.row-scroll { width: 100%; }
.row-scroll .center,
.row-scroll .stack-col-start {
  width: max-content;
  min-width: 100%;
}
/* 01: flex flex-wrap items-start gap-x-10 gap-y-6 */
.wrap-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  column-gap: 80rpx;
  row-gap: 48rpx;
}
/* stack layout: gap-6 (24rpx) */
.stack-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 48rpx;
}
.stack-col-start {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 32rpx;
}
/* order card stepper row: flex items-center gap-3 */
.qty-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.status-line {
  font-size: 25rpx;
  color: #8a857c;
}
/* agent popover sheet */
.pop-head {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a2420;
}
.pop-body {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pop-strong {
  font-size: 25rpx;
  font-weight: 700;
  color: #2a2420;
}
.pop-desc {
  font-size: 25rpx;
  color: #8a857c;
  line-height: 1.6;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
