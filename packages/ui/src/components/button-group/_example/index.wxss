.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center { display: flex; justify-content: center; }
/* 01: flex flex-wrap items-start gap-x-10 gap-y-6 */
.wrap-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  column-gap: 80rpx;
  row-gap: 48rpx;
}
/* stack layout: gap-6 (24rpx) */
.stack-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 48rpx;
}
.stack-col-start {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 32rpx;
}
/* order card stepper row: flex items-center gap-3 */
.qty-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.status-line {
  font-size: 25rpx;
  color: #8a857c;
}
/* agent popover sheet */
.pop-head {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a2420;
}
.pop-body {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pop-strong {
  font-size: 25rpx;
  font-weight: 700;
  color: #2a2420;
}
.pop-desc {
  font-size: 25rpx;
  color: #8a857c;
  line-height: 1.6;
}
