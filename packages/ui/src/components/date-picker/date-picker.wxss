/* ll-date-picker — upstream date-picker.tsx (PickerShell). The field is
   h-9 with Kevin Sans blue felt text; the slip mirrors the select panel
   (fade + zoom-95, --ll-dur-pop) and holds the preset row over the
   calendar. */
/* @ll-import tokens */

.ll-dp {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: 72rpx; /* h-9 */
  padding-left: 24rpx; /* ps-3 */
  font-family: 'Kevin Sans', sans-serif;
  font-size: 28rpx; /* text-base x .88 */
  color: #2c4f9e; /* text-(--ll-input-ink) */
}
.ll-dp--btn {
  cursor: default;
  justify-content: space-between;
  gap: 16rpx;
  white-space: nowrap;
}
.ll-dp--disabled {
  color: #5a554e; /* disabled:text-pencil-text */
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
.ll-dp__control {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 1;
  padding-right: 8rpx; /* pe-1 */
  font-family: 'Kevin Sans', sans-serif;
  font-size: 28rpx;
  color: #2c4f9e; /* --ll-input-ink — what you type is blue felt */
}
.ll-dp__placeholder {
  color: #5a554e; /* --ll-placeholder */
}
.ll-dp__calbtn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx; /* size-7 */
  height: 56rpx;
  margin-right: 4rpx; /* me-0.5 */
  flex-shrink: 0;
  border-radius: 8rpx;
}
.ll-dp__calbtn--hi {
  background: rgba(44, 79, 158, 0.1);
}
.ll-dp__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ll-dp__value--ph {
  color: #5a554e; /* --ll-placeholder */
}
.ll-dp__calico {
  display: grid;
  place-items: center;
  width: 64rpx; /* w-8 */
  height: 100%;
  flex-shrink: 0;
  color: #8a857c; /* text-ink-soft */
}

/* the slip */
.ll-dp__catcher {
  position: fixed;
  inset: 0;
  z-index: 1010; /* --ll-z-popover */
  background: transparent;
}
.ll-dp__panel {
  position: fixed;
  z-index: 1011;
  box-sizing: border-box;
  font-family: 'Kevin Sans', sans-serif;
  color: #2a2420; /* text-popover-foreground = --ll-ink */
  animation: ll-dp-in 180ms cubic-bezier(0.2, 0.9, 0.3, 1.15) both;
}
.ll-dp__panel.is-placing {
  opacity: 0;
  animation: none;
  transition: none;
}
.ll-dp__panel--closing {
  animation: ll-dp-out 150ms ease-in both;
}
@keyframes ll-dp-in {
  0% {
    opacity: 0;
    transform: scale(0.95) translateY(-8px);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}
@keyframes ll-dp-out {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: scale(0.95);
  }
}
/* presets: a wrap row over the calendar on a phone (upstream's sm:
   column comes back as the two-month slip when the screen allows) */
.ll-dp__presets {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 24rpx 24rpx 16rpx; /* p-3 pb-2 */
  border-bottom: 1px solid rgba(142, 136, 127, 0.4); /* border-pencil-mark/40 */
  box-sizing: border-box;
}
.ll-dp__calwrap {
  display: block;
  padding: 16rpx 16rpx 24rpx; /* breathing room inside the slip */
  box-sizing: border-box;
}
