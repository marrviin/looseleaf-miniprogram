.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  max-width: 768rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* upstream text-[17px] leading-[1.6] */
.para {
  font-size: 30rpx;
  line-height: 1.6;
  color: #2a2420;
}
/* upstream: grid grid-cols-[5.5rem_1fr] items-center gap-3 text-sm
   text-muted-foreground */
.kind-row {
  display: grid;
  grid-template-columns: 192rpx 1fr;
  align-items: center;
  column-gap: 24rpx;
  font-size: 26rpx;
  color: var(--ll-ink-muted, #4a433c);
}
.kind-name {
  font-size: 26rpx;
}
/* upstream: flex h-28 gap-6 */
.vertical-strip {
  display: flex;
  height: 224rpx;
  column-gap: 48rpx;
}
