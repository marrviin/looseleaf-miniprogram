/* ll-squiggle — upstream: relative isolate shrink-0; horizontal h-4 w-full,
   vertical h-full min-h-8 w-4. Sizes × 0.88 × 2 = rpx (16px → 28rpx,
   32px → 56rpx). */
.ll-squiggle {
  position: relative;
  isolation: isolate;
  flex-shrink: 0;
  outline: none;
}
.ll-squiggle--h {
  height: 28rpx;
  width: 100%;
}
.ll-squiggle--v {
  height: 100%;
  min-height: 56rpx;
  width: 28rpx;
}
.ll-ink-layer {
  position: absolute;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
/* upstream MARK_REVEAL animates the stroke itself (SVG dash); the port
   approximates the draw-on with a fade+rise of the whole layer. */
.ll-squiggle--animate .ll-ink-layer {
  animation: ll-squiggle-draw 0.6s ease-out both;
}
@keyframes ll-squiggle-draw {
  from {
    opacity: 0;
    transform: translateY(6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
