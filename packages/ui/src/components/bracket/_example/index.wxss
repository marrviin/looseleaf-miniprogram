.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  max-width: 768rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* upstream text-[17px] leading-[1.6] */
.para {
  font-size: 30rpx;
  line-height: 1.6;
  color: #2a2420;
}
/* upstream: grid gap-6 sm:grid-cols-2 — the docs page is ≥640px wide;
   on the miniprogram screen it stays one column, so the w-44 brackets
   keep their 384rpx width without clipping. */
.grid2 {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48rpx;
  margin-bottom: 24rpx;
}
/* upstream: flex items-center gap-2 */
.group-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
/* upstream: ul grid gap-1.5 text-[17px] */
.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 30rpx;
  color: #2a2420;
}
/* placeholder for the (not yet ported) callout: a small hand note */
.note {
  font-family: var(--font-script, cursive);
  font-size: 30rpx;
  color: var(--ll-ink-you, #2c4f9e);
}
