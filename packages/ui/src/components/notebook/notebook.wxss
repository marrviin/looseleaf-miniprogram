/* ll-notebook — upstream: font-hand text-[17px]; start-bound
   pt-4 pe-6 pb-7 ps-14 leading-7, top-bound pt-10 pe-6 pb-6 ps-6
   leading-[30px]. Content sits on the printed rules (pitch baked in
   ll-paper's rules layer). */
/* @ll-import tokens */
.ll-notebook {
  box-sizing: border-box;
  width: 100%;
  padding: 16px 24px 28px 56px; /* pt-4 pe-6 pb-7 ps-14 */
  font-size: 17px;
  line-height: 28px; /* leading-7 — the 'ruled' pitch */
  color: var(--ll-ink, #2a2420);
  font-family: 'Kevin Sans', 'PingFang SC', sans-serif;
}
.ll-notebook--top {
  padding: 40px 24px 24px; /* pt-10 pe-6 pb-6 ps-6 */
  line-height: 30px; /* the 'pad' pitch */
}

/* binding/page-edges decor, drawn on the paper box (pad 26). */
.ll-notebook__decor {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
