<!-- ll-doodle — the box is the square size; the art layer bleeds -pad px
     past it (upstream overflow-visible svg). aria: role img + label when
     labeled, hidden otherwise; an unknown name draws nothing. -->
<view
  class="ll-doodle ll-class"
  style="width:{{px}}px;height:{{px}}px;{{tf}}{{customStyle}}"
  aria-role="{{label ? 'img' : 'none'}}"
  aria-label="{{label}}"
  aria-hidden="{{label ? 'false' : 'true'}}"
>
  <view wx:if="{{has}}" class="ll-doodle__art" style="{{artStyle}}"></view>
</view>
