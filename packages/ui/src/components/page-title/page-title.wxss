/* ll-page-title — font-script text-[2.6rem] leading-[1.08] font-bold
   pb-1.5 w-fit; the mark layer is measured at the title's box. */
/* @ll-import tokens */
.ll-page-title {
  position: relative;
  isolation: isolate;
  box-sizing: border-box;
  width: fit-content;
  max-width: 100%;
  padding-bottom: 6px; /* pb-1.5 */
  font-family: 'Kevin Sans', 'PingFang SC', sans-serif; /* font-script */
  font-size: 42px; /* 2.6rem */
  line-height: 1.08;
  font-weight: 700;
  color: var(--ll-ink, #2a2420);
}

.ll-page-title__ink {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
