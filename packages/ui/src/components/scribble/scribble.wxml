<!-- ll-scribble — the text is rendered as inline word spans so the mark
     behavior can measure line boxes; the scribbles are absolute z-index:1
     layers in front of the words. Until the ink is ready the host shows a
     plain ink line-through (upstream decoration-2 decoration-ink). -->
<view class="ll-mark ll-scribble ll-class {{show && !markReady ? 'll-scribble--fallback' : 'll-scribble--ink-on'}}" style="{{customStyle}}">
  <text class="ll-mark__w" wx:for="{{markWords}}" wx:key="index">{{item}}</text>
  <view wx:for="{{markInk}}" wx:key="index" class="ll-mark__ink" style="{{item}}" />
</view>
