/* ll-envelope demo */
/* @ll-import tokens */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec { margin-top: 40rpx; }
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.row { display: flex; align-items: center; gap: 16rpx; min-height: 40rpx; }
.said {
  font-size: 24rpx;
  color: #8a857c;
}
.env-wrap { margin-top: 48rpx; }
.env-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
}
.env-cell { width: 208px; }
.env-inbox {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
  padding-top: 16rpx;
}
.script-h3 {
  font-family: 'Kevin Sans', sans-serif;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1;
  color: #2a2420;
  margin-bottom: 16rpx;
}
.panel-note {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
}
