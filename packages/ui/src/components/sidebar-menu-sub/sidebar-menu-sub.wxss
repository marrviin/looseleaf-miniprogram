/* ll-sidebar-menu-sub — relative isolate; mx-3.5 px-2.5 py-0.5 gap-1. */
.ll-sidebar-menu-sub {
  position: relative;
  z-index: 0;
  margin-left: 56rpx; /* mx-3.5 */
  margin-right: 56rpx;
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx; /* gap-1 */
  padding: 4rpx 20rpx; /* px-2.5 py-0.5 */
  box-sizing: border-box;
}
.ll-sidebar-menu-sub__content {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}
.ll-sidebar-menu-sub.is-collapsed {
  display: none;
}
