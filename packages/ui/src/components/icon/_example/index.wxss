.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 40rpx; /* gap-5 */
}
.row--wrap {
  flex-wrap: wrap;
}
.row--items-end {
  align-items: flex-end;
  gap: 48rpx; /* gap-6 */
}
.row--gap2 {
  gap: 16rpx; /* gap-2 */
}
.row--gap3 {
  gap: 24rpx; /* gap-3 */
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* gap-4 */
  padding: 8rpx 0;
}
.stack--tight {
  gap: 16rpx; /* gap-2 */
  padding: 0;
}
.row-label {
  width: 128rpx; /* w-16 */
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60;
}
.figure {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx; /* gap-1 */
}
.figcaption {
  font-size: 25rpx; /* text-sm × 0.88 */
  color: #6f6a60;
}

/* gallery — upstream: grid auto-fill minmax(7.5rem,1fr) gap-3 */
.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.gallery-cell {
  width: 215rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0; /* py-2 */
  box-sizing: border-box;
}
