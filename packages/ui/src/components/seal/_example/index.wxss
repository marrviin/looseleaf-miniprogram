.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.seal-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: center;
  gap: 48rpx; /* gap-6 */
  padding: 24rpx 0 32rpx;
}
.cert-grid {
  display: flex;
  flex-direction: column;
  gap: 48rpx; /* gap-6 */
  padding: 24rpx 0 32rpx;
}
.cert-col {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}
.who {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.who-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.who-name {
  display: flex;
  align-items: center;
  gap: 12rpx; /* gap-1.5 */
  font-size: 32rpx; /* text-lg */
  font-weight: 700;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.who-role {
  font-size: 24rpx;
  color: #8a857c;
}
.card-pos {
  position: relative;
}
.best-pin {
  pointer-events: none;
}
.cert-eyebrow {
  font-size: 21rpx; /* text-xs 12px x .88 */
  color: #6b6459;
}
.cert-title {
  font-size: 70rpx; /* text-4xl 36px x .88 -> ~63rpx, script face reads larger */
  font-weight: 700;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.cert-body {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  max-width: 576rpx;
}
.cert-seals {
  display: flex;
  align-items: flex-end;
  gap: 32rpx; /* gap-4 */
  margin-top: 24rpx;
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
