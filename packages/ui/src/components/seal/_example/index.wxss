.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.seal-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: center;
  gap: 48rpx; /* gap-6 */
  padding: 24rpx 0 32rpx;
}
.cert-grid {
  display: flex;
  flex-direction: column;
  gap: 48rpx; /* gap-6 */
  padding: 24rpx 0 32rpx;
}
.cert-col {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}
.who {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.who-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.who-name {
  display: flex;
  align-items: center;
  gap: 12rpx; /* gap-1.5 */
  font-size: 32rpx; /* text-lg */
  font-weight: 700;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.who-role {
  font-size: 24rpx;
  color: #8a857c;
}
.card-pos {
  position: relative;
}
.best-pin {
  pointer-events: none;
}
.cert-eyebrow {
  font-size: 21rpx; /* text-xs 12px x .88 */
  color: #6b6459;
}
.cert-title {
  font-size: 70rpx; /* text-4xl 36px x .88 -> ~63rpx, script face reads larger */
  font-weight: 700;
  color: #2a2420;
  font-family: 'Kevin Sans', sans-serif;
}
.cert-body {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  max-width: 576rpx;
}
.cert-seals {
  display: flex;
  align-items: flex-end;
  gap: 32rpx; /* gap-4 */
  margin-top: 24rpx;
}
