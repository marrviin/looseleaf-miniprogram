<!-- ll-ribbon demo — mirrors the upstream docs page (#/components/ribbon).
     asChild ribbons render as interactive ribbons (React-slot has no
     miniprogram equivalent); the 1px hover lift needs a mouse. -->
<view class="demo">
  <ll-page-title underline="highlight" seed="ribbon" custom-style="margin-bottom:16rpx;">Ribbon</ll-page-title>
  <view class="sec-desc">A ribbon label: a band of colored paper with words on it, folded ends and all. For a section heading, a New flag on a card, a price label or a call to action.</view>

  <view class="sec sec--grid">
    <view class="sec-h2">Preview</view>
    <view class="sub-h3">A banner</view>
    <view class="sec-desc">A band of colored paper with folded, swallow-tailed ends. The words are real text; the paper is drawn behind them and grows with them.</view>
    <view class="center-col">
      <ll-ribbon size="lg">New arrivals</ll-ribbon>
      <ll-ribbon tone="sky">Staff pick</ll-ribbon>
      <ll-ribbon size="sm" tone="grass">In stock</ll-ribbon>
    </view>
  </view>

  <view class="sec sec--grid">
    <view class="sec-h2">Examples</view>
    <view class="sub-h3">Variants and colors</view>
    <view class="sec-desc">Banner (folded tails), swallow (a V notch at both ends) and flag (square at the start). The colors are the ones ink stays readable on; `paper` is a plain white ribbon.</view>
    <view class="ribbon-row">
      <ll-ribbon variant="banner">Banner</ll-ribbon>
      <ll-ribbon variant="swallow" tone="lemon">Swallow</ll-ribbon>
      <ll-ribbon variant="flag" tone="tangerine">Flag</ll-ribbon>
    </view>
    <view class="ribbon-row ribbon-row--tones">
      <ll-ribbon wx:for="{{tones}}" wx:key="*this" tone="{{item}}" size="sm" bindtap="onToneTap">{{item}}</ll-ribbon>
    </view>
    <view class="tap-note" wx:if="{{lastTone}}">tapped: {{lastTone}}</view>
  </view>

  <view class="sec sec--desk">
    <view class="sec-h2">On cards and as links</view>
    <view class="sec-desc">A flag pinned to a card edge, a banner as a section heading, and a ribbon that is a link: `asChild` puts the drawing on your element, which lifts on hover and takes the drawn focus ring.</view>
    <view class="cards-grid">
      <view class="card-pos">
        <ll-card custom-style="position:relative;margin-top:24rpx;">
          <ll-card-header>
            <ll-card-title>Twelve felt tips</ll-card-title>
            <ll-card-description>Assorted, water based, no bleed.</ll-card-description>
          </ll-card-header>
          <ll-card-content custom-style="display:flex;align-items:center;justify-content:space-between">
            <text class="price">$ 14.00</text>
            <ll-ribbon id="ribbonLink" variant="swallow" tone="lemon" size="sm" interactive>See details</ll-ribbon>
          </ll-card-content>
        </ll-card>
        <ll-ribbon
          class="flag-pin"
          variant="flag"
          tone="tangerine"
          size="sm"
          custom-style="position:absolute;top:-24rpx;left:-24rpx;z-index:2"
        >New</ll-ribbon>
      </view>
      <view class="link-col">
        <ll-ribbon size="lg" tone="teal">Spring stationery</ll-ribbon>
        <text class="body-text">Notebooks, washi tape and the good pencils, in the shop until the end of April.</text>
        <ll-ribbon id="ribbonButton" tone="sky" interactive bindtap="onShopTap">Shop the collection</ll-ribbon>
        <view class="tap-note" wx:if="{{shopTaps}}">shop taps: {{shopTaps}}</view>
      </view>
    </view>
  </view>
</view>
