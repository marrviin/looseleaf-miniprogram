.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack-12 {
  display: flex;
  flex-direction: column;
  gap: 40rpx; /* form gap-5 */
  padding: 16rpx 0;
}
.said-line {
  font-size: 25rpx;
  color: #4a433c;
}
.form-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.digest-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.terms-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
