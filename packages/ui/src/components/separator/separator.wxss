/* ll-separator — horizontal h-px w-full, vertical w-px h-full (shadcn);
   labeled mode is a flex row (column when vertical) of two rules and the
   hand-font label (upstream: shrink-0 items-center gap-3). */
/* @ll-import tokens */
.ll-separator {
  position: relative;
  display: block;
  flex-shrink: 0;
}
.ll-separator--horizontal {
  width: 100%;
  height: 1px;
}
.ll-separator--vertical {
  width: 1px;
  height: 100%;
}

.ll-separator--labeled {
  display: flex;
  align-items: center;
  gap: 12rpx; /* gap-3 */
  height: auto;
}
.ll-separator--labeled.ll-separator--horizontal {
  width: 100%;
}
.ll-separator--labeled.ll-separator--vertical {
  flex-direction: column;
  width: auto;
  height: 100%;
}

.ll-separator__label {
  flex-shrink: 0;
  font-family: 'Kevin Sans', sans-serif;
  font-size: 25rpx; /* text-sm × 0.88 */
  font-weight: 700;
  line-height: 1;
  color: var(--muted-foreground, #4a433c);
  user-select: none;
}
