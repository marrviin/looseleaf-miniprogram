.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* seven ways: variant name above each rule */
.ways {
  display: flex;
  flex-direction: column;
  gap: 56rpx; /* gap-7 */
  max-width: 896rpx; /* max-w-md */
  padding: 24rpx 0;
}
.way {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.way-name {
  font-size: 25rpx;
  color: var(--muted-foreground, #4a433c);
}

/* sign-in card */
.card-stage {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx; /* gap-3 */
}
.footer-note {
  font-size: 25rpx;
  color: var(--muted-foreground, #4a433c);
}

/* vertical rule rows */
.vrows {
  display: flex;
  flex-direction: column;
  gap: 64rpx; /* gap-8 */
  padding: 24rpx 0;
}
.vrow {
  display: flex;
  align-items: center;
}
.vrow--h6 {
  height: 48rpx; /* h-6 */
  gap: 32rpx; /* gap-4 */
}
.vrow--h10 {
  height: 80rpx; /* h-10 */
  gap: 48rpx; /* gap-6 */
}
.vrow--h5 {
  height: 40rpx; /* h-5 */
  gap: 32rpx;
}
.vrow-t {
  font-size: 26rpx; /* text-[15px] × 0.88 */
  color: #2a2420;
}

/* page sections article */
.article {
  display: flex;
  flex-direction: column;
  gap: 40rpx; /* gap-5 */
  max-width: 896rpx;
  padding: 24rpx 0;
}
.day {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.day-h {
  font-family: 'Kevin Sans', sans-serif; /* font-script falls back to Kevin Sans upstream too */
  font-size: 53rpx; /* text-3xl × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.day-p {
  font-size: 26rpx;
  line-height: 1.375; /* leading-snug */
  color: #2a2420;
}

/* demo box */
.demo-box {
  padding: 8rpx 0 24rpx;
}
.demo-stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx; /* space-y-1 */
}
.demo-h4 {
  font-size: 25rpx;
  line-height: 1;
  font-weight: 500;
  color: #2a2420;
}
.demo-p {
  font-size: 25rpx;
  color: var(--muted-foreground, #4a433c);
}
