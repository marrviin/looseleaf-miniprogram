.demo {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
  padding: 32rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* seven ways: variant name above each rule */
.ways {
  display: flex;
  flex-direction: column;
  gap: 56rpx; /* gap-7 */
  max-width: 896rpx; /* max-w-md */
  padding: 24rpx 0;
}
.way {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.way-name {
  font-size: 25rpx;
  color: var(--muted-foreground, #4a433c);
}

/* sign-in card */
.card-stage {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx; /* gap-3 */
}
.footer-note {
  font-size: 25rpx;
  color: var(--muted-foreground, #4a433c);
}

/* vertical rule rows */
.vrows {
  display: flex;
  flex-direction: column;
  gap: 64rpx; /* gap-8 */
  padding: 24rpx 0;
}
.vrow {
  display: flex;
  align-items: center;
}
.vrow--h6 {
  height: 48rpx; /* h-6 */
  gap: 32rpx; /* gap-4 */
}
.vrow--h10 {
  height: 80rpx; /* h-10 */
  gap: 48rpx; /* gap-6 */
}
.vrow--h5 {
  height: 40rpx; /* h-5 */
  gap: 32rpx;
}
.vrow-t {
  font-size: 26rpx; /* text-[15px] × 0.88 */
  color: #2a2420;
}

/* page sections article */
.article {
  display: flex;
  flex-direction: column;
  gap: 40rpx; /* gap-5 */
  max-width: 896rpx;
  padding: 24rpx 0;
}
.day {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.day-h {
  font-family: 'Kevin Sans', sans-serif; /* font-script falls back to Kevin Sans upstream too */
  font-size: 53rpx; /* text-3xl × 0.88 */
  font-weight: 700;
  color: #2a2420;
}
.day-p {
  font-size: 26rpx;
  line-height: 1.375; /* leading-snug */
  color: #2a2420;
}

/* demo box */
.demo-box {
  padding: 8rpx 0 24rpx;
}
.demo-stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx; /* space-y-1 */
}
.demo-h4 {
  font-size: 25rpx;
  line-height: 1;
  font-weight: 500;
  color: #2a2420;
}
.demo-p {
  font-size: 25rpx;
  color: var(--muted-foreground, #4a433c);
}


/* per-case Stage surface - upstream example meta.stage (kit/Stage.tsx):
   "desk" = sage linen block, default = dot-grid sheet. */
.sec--desk {
  background-color: var(--ll-desk, #a8c8bb);
  background-image: var(--ll-tex-linen);
  background-size: 160px 160px;
  background-repeat: repeat;
  box-shadow: inset 0 0 18px -2px rgba(58,44,30,0.4);
}
.sec--grid {
  background-color: var(--ll-graph, #f4f7ef);
  background-image:
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    radial-gradient(circle at center, rgba(142,136,127,0.9) 0 0.8px, transparent 1.15px),
    var(--ll-tex-fibre),
    var(--ll-tex-slip),
    var(--ll-tex-cloud),
    linear-gradient(135deg, rgba(255,255,255,0.38), rgba(255,255,255,0) 42%, rgba(58,44,30,0.035));
  background-size: 20px 20px, 20px 20px, 240px 240px, 128px 128px, 720px 720px, 100% 100%;
  background-position: 0 0, 10px 10px, 0 0, 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat;
  box-shadow: 0 1px 0 rgba(58,44,30,0.2), 0 4px 8px -3px rgba(58,44,30,0.2);
  border-radius: 2px;
}
