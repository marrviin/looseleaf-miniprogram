.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  max-width: 768rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* upstream text-[17px] */
.para {
  font-size: 30rpx;
  color: #2a2420;
}
/* upstream: flex flex-wrap gap-x-6 */
.row {
  display: flex;
  flex-wrap: wrap;
  column-gap: 48rpx;
  row-gap: 20rpx;
}
/* upstream ll-num font-script text-5xl */
.price {
  font-family: var(--font-script, cursive);
  font-size: 84rpx;
  line-height: 1.2;
  color: #2a2420;
}
/* upstream ms-2 font-hand text-base text-muted-foreground */
.per {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--ll-ink-muted, #4a433c);
}
/* upstream text-sm text-muted-foreground */
.footnote {
  font-size: 26rpx;
  color: var(--ll-ink-muted, #4a433c);
}
