/* ll-typewriter — shown words + drawn caret + reserve spacer.
   @ll-import tokens */
:host {
  display: inline-block;
}
.ll-typewriter {
  position: relative;
  white-space: pre-wrap;
  font-family: 'Kevin Sans', sans-serif;
  color: #2a2420;
}
.ll-typewriter__sr {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}
.ll-typewriter__room {
  visibility: hidden;
}
.ll-typewriter__live--abs {
  position: absolute;
  inset: 0;
}
.ll-typewriter__line {
  white-space: pre-wrap;
}
.ll-typewriter__w {
  position: relative;
  display: inline;
}
.ll-typewriter__caret {
  display: inline-block;
  vertical-align: text-bottom;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
@keyframes ll-caret {
  0%,
  49% {
    opacity: 1;
  }
  50%,
  100% {
    opacity: 0;
  }
}
.ll-typewriter.is-idle .ll-typewriter__caret {
  animation: ll-caret 1.1s steps(1) infinite;
}
