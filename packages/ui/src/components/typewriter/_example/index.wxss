.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.type-para {
  min-height: 168rpx;
  max-width: 576px;
}
.type-cycle {
  text-align: center;
}
.type-script {
  font-size: 36px;
  color: #2a2420;
}
.type-cycle-word {
  display: inline-block;
  width: 11em;
  text-align: left;
  vertical-align: baseline;
}
.col-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.type-receipt {
  font-size: 16px;
  line-height: 28px;
}
.type-foot {
  height: 72rpx;
}
