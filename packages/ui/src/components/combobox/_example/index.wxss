.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
/* 01/03/04: upstream w-64 */
.w64 {
  width: 256px;
  max-width: 100%;
}
/* 02: upstream w-96 */
.w96 {
  width: 384px;
  max-width: 100%;
}
/* label + field stacks (upstream grid gap-2) */
.field-grid {
  display: grid;
  gap: 16rpx;
}
.said-line {
  font-size: 25rpx; /* text-sm ×0.88 */
  color: #8a857c;
  margin: -8rpx 0 24rpx;
}
/* 05: the shipping card (upstream max-w-sm) */
.ship-card {
  width: 100%;
  max-width: 384px;
}
.ship-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
/* 50: the task row on its paper (upstream px-4 py-2, gap-3) */
.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 32rpx;
}
.task-row-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.task-row-text {
  font-size: 28rpx;
  color: #8a857c; /* text-muted-foreground */
}
/* 51/52: the status picker row */
.status-row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 */
  margin-bottom: 24rpx;
}
.status-label {
  font-family: 'Kevin Sans', sans-serif; /* font-hand */
  font-size: 25rpx; /* text-sm ×0.88 */
  color: #4a433c; /* text-ink-muted */
}
/* 52: the dashed seam under the drawer header */
.dashed-top {
  margin-top: 32rpx;
  border-top: 1px dashed #a09a8e; /* border-pencil-mark/60 */
}
