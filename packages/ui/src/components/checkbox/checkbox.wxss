/* @ll-import tokens */
.ll-checkbox {
  position: relative;
  isolation: isolate;
  display: inline-block;
  flex-shrink: 0;
  width: 32rpx; /* size-4 */
  height: 32rpx;
  box-sizing: border-box;
}
/* upstream after:-inset-1.5 — the finger target is bigger than the drawing */
.ll-checkbox::after {
  content: '';
  position: absolute;
  inset: -12rpx;
}
.ll-ink-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
