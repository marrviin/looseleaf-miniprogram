.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  justify-content: center;
  padding: 32rpx 16rpx;
}
/* The receipt headline — upstream's [&>:first-child] on ReceiptHeader
   (text-base font-bold; page-owned slot nodes, so it lives here) */
.receipt-headline {
  font-size: 26rpx;
  font-weight: 700;
}

/* "Four ways to cut it" — grid grid-cols-2 justify-items-center gap-x-8
   gap-y-10 p-4 */
.ends-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  justify-items: center;
  column-gap: 56rpx; /* gap-x-8 */
  row-gap: 70rpx; /* gap-y-10 */
  padding: 28rpx; /* p-4 */
}
/* "An order summary" — flex flex-wrap items-start justify-center gap-x-12
   gap-y-8 */
.order-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: center;
  column-gap: 84rpx; /* gap-x-12 */
  row-gap: 56rpx; /* gap-y-8 */
  padding: 32rpx 0;
}
/* The stepper column — flex flex-col gap-3 pt-6 */
.steppers {
  display: flex;
  flex-direction: column;
  gap: 21rpx; /* gap-3 */
  padding-top: 42rpx; /* pt-6 */
}
.stepper {
  display: flex;
  align-items: center;
  gap: 21rpx; /* gap-3 */
}
.stepper-name {
  width: 253rpx; /* w-36 */
  color: #2a2420; /* text-ink */
}
