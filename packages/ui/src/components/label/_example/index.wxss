.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* gap-4 */
  padding: 16rpx 0;
}
.stack.gap5 {
  gap: 40rpx; /* gap-5 */
}
/* upstream grid max-w-sm gap-2 (a label over its field) */
.grid-sm {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* gap-2 */
  max-width: 768rpx; /* max-w-sm */
}
/* label + control in one row (flex items-center gap-2 / space-x-2) */
.row2 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  max-width: 768rpx;
}
.opt {
  font-weight: 400;
  color: #4a433c; /* text-ink-muted */
  margin-left: 8rpx; /* WXML collapses the source space — restore it */
}
