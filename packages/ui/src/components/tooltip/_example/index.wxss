/* ll-tooltip demo — shared demo base + tooltip-specific bits. */
.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.center-row {
  display: flex;
  align-items: center;
  gap: 32rpx; /* gap-4 */
  margin-bottom: 24rpx;
}
.center-row.wrap {
  flex-wrap: wrap;
}

/* 01: the icon toolbar row (upstream flex gap-2 pt-10) */
.toolbar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 40rpx;
}

/* 03: "Copy ⌘C" — mono hint (upstream font-mono text-xs opacity-70) */
.hint-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.kbd-hint {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 21rpx;
  opacity: 0.7;
}

/* 04: the focusable wrapper around the disabled button */
.disabled-wrap {
  display: inline-block;
}
