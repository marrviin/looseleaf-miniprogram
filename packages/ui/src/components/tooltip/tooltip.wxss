/* ll-tooltip — upstream tooltip.tsx: sticky note + felt-tip arrow.
   Pop in: fade + zoom-in-95 + slide-in-from-side-2 (8px) over
   --ll-dur-pop (0.18s); out: fade + zoom-out-95. */
/* @ll-import tokens */

.ll-tooltip {
  display: inline-block;
}

.ll-tooltip__trigger {
  display: inline-block;
}

/* transparent full-screen catcher under the note (z --ll-z-popover: 1010) */
.ll-tooltip__catcher {
  position: fixed;
  inset: 0;
  z-index: 1010;
  background: transparent;
}

.ll-tooltip__panel {
  position: fixed;
  z-index: 1011;
  /* w-fit max-w-[min(22rem,calc(100vw-1rem))] — a fixed box shrink-wraps
     its content, which IS w-fit */
  max-width: min(352px, calc(100vw - 16px));
  font-family: 'Kevin Sans', sans-serif;
  color: #2a2420; /* text-foreground = --ll-ink */
  opacity: 1;
  animation: ll-tooltip-in 180ms cubic-bezier(0.2, 0.9, 0.3, 1.15) both;
}
.ll-tooltip__panel.is-placing {
  opacity: 0;
  animation: none;
  transition: none;
}
.ll-tooltip__panel--closing {
  animation: ll-tooltip-out 150ms ease-in both;
}

@keyframes ll-tooltip-in {
  0% {
    opacity: 0;
    transform: scale(0.95) translateY(-8px);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}
@keyframes ll-tooltip-out {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: scale(0.95);
  }
}

/* px-2.5 py-1.5 text-sm/snug break-words text-balance */
.ll-tooltip__content {
  display: block;
  padding: 12rpx 20rpx;
  font-size: 23rpx;
  line-height: 38rpx;
  word-break: break-word;
}

/* the felt-tip pointer (pointerMark svg 24x22 box, rotated per side) */
.ll-tooltip__arrow {
  position: absolute;
  width: 24px;
  height: 22px;
  pointer-events: none;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  z-index: 3;
}
