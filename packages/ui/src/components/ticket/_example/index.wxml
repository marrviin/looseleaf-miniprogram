<!-- ll-ticket demo — mirrors the upstream docs page
     (#/components/ticket). The "Taped to the page" example uses the
     standalone ll-tape (ported) — angle via custom-style rotate. -->
<view class="demo">
  <view class="demo-title">Ticket</view>
  <view class="sec-desc">A printed ticket: concave corners, a bite out of both edges where the stub tears off, and a row of holes along the tear. The whole silhouette is drawn, holes and all.</view>

  <view class="sec">
    <view class="sec-h2">Preview</view>
    <view class="sub-h3">Admit one</view>
    <view class="sec-desc">Kraft stock, the stub on the end, the serial in the red-ink mix.</view>
    <view class="row">
      <ll-ticket seed="admit" aria-label="Ticket number 0042" custom-style="max-width:789rpx">
        <ll-ticket-body>
          <ll-ticket-title>Admit one</ll-ticket-title>
          <ll-ticket-description>Le Grand Jardin</ll-ticket-description>
          <ll-ticket-number>No. 0042</ll-ticket-number>
        </ll-ticket-body>
        <ll-ticket-stub width="{{88}}">
          <ll-ticket-number custom-style="font-size:30rpx">
            <text class="block-xs">No.</text>
            0042
          </ll-ticket-number>
        </ll-ticket-stub>
      </ll-ticket>
    </view>
  </view>

  <view class="sec">
    <view class="sec-h2">Examples</view>
    <view class="sub-h3">Stocks, stubs, used</view>
    <view class="sec-desc">Kraft, cream, cinema yellow and tram-ticket pink. The stub can be at the start, wider, or not there; a punched hole says it has been used.</view>
    <view class="stack">
      <ll-ticket stock="sticky-yellow" punched seed="cinema" aria-label="Cinema ticket, used">
        <ll-ticket-body>
          <ll-ticket-title>Cinema</ll-ticket-title>
          <ll-ticket-description>Sat 27 Sep - 19:30</ll-ticket-description>
          <ll-ticket-number>Screen 2 - Row F - Seat 14</ll-ticket-number>
        </ll-ticket-body>
        <ll-ticket-stub width="{{88}}">
          <ll-ticket-number custom-style="font-size:30rpx">1187</ll-ticket-number>
        </ll-ticket-stub>
      </ll-ticket>
      <ll-ticket stock="index-card" stub="start" stub-width="{{80}}" seed="raffle" aria-label="Raffle ticket 311">
        <ll-ticket-body>
          <ll-ticket-title>Raffle</ll-ticket-title>
          <ll-ticket-description>Win a very small pencil</ll-ticket-description>
        </ll-ticket-body>
        <ll-ticket-stub width="{{80}}">
          <ll-ticket-number custom-style="font-size:33rpx">311</ll-ticket-number>
        </ll-ticket-stub>
      </ll-ticket>
      <ll-ticket stock="sticky-pink" stub="none" seed="tram" aria-label="One tram ride">
        <ll-ticket-body custom-style="align-items:center;text-align:center">
          <ll-ticket-title>One ride</ll-ticket-title>
          <ll-ticket-description>Good until the last tram</ll-ticket-description>
        </ll-ticket-body>
      </ll-ticket>
      <ll-ticket stub-width="{{120}}" seed="fair" aria-label="Fair entry 0007">
        <ll-ticket-body>
          <ll-ticket-title>Admit one</ll-ticket-title>
          <ll-ticket-description>The Looseleaf Fair - Sunday</ll-ticket-description>
        </ll-ticket-body>
        <ll-ticket-stub width="{{120}}">
          <ll-ticket-number custom-style="font-size:33rpx">
            <text class="block-xs">No.</text>
            0007
          </ll-ticket-number>
        </ll-ticket-stub>
      </ll-ticket>
    </view>
  </view>

  <view class="sec">
    <view class="sub-h3">Taped to the page</view>
    <view class="sec-desc">A ticket is an ordinary positioned box: tape and stamps go on it with plain styles. Its shadow follows the notches and the holes.</view>
    <view class="row">
      <view class="taped-wrap">
        <ll-tape kind="washi-stripes" length="{{72}}" height="{{22}}" angle="{{-24}}" custom-style="position:absolute;top:-14rpx;left:-24rpx;z-index:10" />
        <ll-ticket stock="kraft" tilt="{{-2}}" seed="taped" aria-label="Ticket 0099" custom-style="max-width:789rpx">
          <ll-ticket-body>
            <ll-ticket-title>Admit one</ll-ticket-title>
            <ll-ticket-description>Museum of small things</ll-ticket-description>
          </ll-ticket-body>
          <ll-ticket-stub width="{{88}}">
            <ll-ticket-number custom-style="font-size:30rpx">0099</ll-ticket-number>
          </ll-ticket-stub>
        </ll-ticket>
      </view>
    </view>
  </view>

  <view class="sec">
    <view class="sub-h3">Your tickets</view>
    <view class="sec-desc">A real list: tickets with an action, a status, and a punched hole once used. The state lives in your app; the ticket only shows it.</view>
    <view class="stack stack--wide">
      <view wx:for="{{tickets}}" wx:key="no">
        <ll-ticket
          punched="{{item.used}}"
          seed="{{item.no}}"
          aria-label="{{item.event}}, ticket {{item.no}}{{item.used ? ', used' : ''}}"
        >
          <ll-ticket-body>
            <ll-ticket-title>{{item.event}}</ll-ticket-title>
            <ll-ticket-description>{{item.when}}</ll-ticket-description>
            <view class="pt-1">
              <ll-ticket-number wx:if="{{item.used}}">Used</ll-ticket-number>
              <ll-button wx:else size="sm" variant="secondary" data-no="{{item.no}}" bindtap="onScan">Scan at the door</ll-button>
            </view>
          </ll-ticket-body>
          <ll-ticket-stub width="{{88}}">
            <ll-ticket-number custom-style="font-size:30rpx">
              <text class="block-xs">No.</text>
              {{item.no}}
            </ll-ticket-number>
          </ll-ticket-stub>
        </ll-ticket>
      </view>
    </view>
  </view>
</view>
