.demo {
  padding: 32rpx;
  background: var(--ll-paper, #f8f5ee);
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-title {
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.sec {
  margin-top: 40rpx;
}
.sec-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2420;
  margin-bottom: 12rpx;
}
.sub-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2420;
  margin: 28rpx 0 6rpx;
}
.sec-desc {
  font-size: 24rpx;
  color: #8a857c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  justify-content: center;
  padding: 32rpx 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 72rpx; /* gap-y-9 */
  padding: 28rpx; /* p-4 */
}
.stack--wide {
  align-items: stretch;
  gap: 56rpx; /* gap-8 */
  max-width: 901rpx; /* max-w-xl */
  margin: 0 auto;
}
.taped-wrap {
  position: relative;
  width: 100%;
  max-width: 789rpx; /* max-w-md */
}
.block-xs {
  display: block;
  font-size: 20rpx; /* text-xs x .82 */
}
.pt-1 {
  padding-top: 7rpx; /* pt-1 */
}
